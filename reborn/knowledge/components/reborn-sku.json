{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-sku",
  "title": "Sku 商品规格",
  "description": "用于商品规格（SKU）选择的选项组件，按 options 渲染规格项并以对象形式双向绑定选中结果。",
  "category": "form",
  "tags": [
    "web",
    "sku",
    "form",
    "select"
  ],
  "aliases": [
    "sku",
    "规格选择",
    "商品规格"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "options",
      "type": "SkuOption[]",
      "required": false,
      "description": "属性组配置列表",
      "default": "() => []"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "自定义类名",
      "default": "—"
    },
    {
      "name": "ui",
      "type": "SkuUi",
      "required": false,
      "description": "UI 覆盖 可用键（从源码抽取，以此为准）——Web：group、item、list、title、wrapper。",
      "default": "() => ({})"
    },
    {
      "name": "modelValue",
      "type": "Record<string, any>",
      "required": false,
      "description": "双向绑定值",
      "vModel": true,
      "default": "{}"
    }
  ],
  "events": [
    {
      "name": "change",
      "payload": "(e: \"change\", key: string, value: any): void;",
      "description": "单个属性组选中值变化时触发，key 为该属性组的 key"
    },
    {
      "name": "update:modelValue",
      "description": "modelValue 变化时触发（v-model 同步）",
      "payload": "(value: Record<string, any>)"
    }
  ],
  "slots": [
    {
      "name": "item",
      "props": "(props: SkuItemSlotProps) => any",
      "description": "自定义单个选项内容"
    }
  ],
  "exposes": [],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-sku/RebornSkuDemo.vue",
      "source": "demo",
      "platform": "web",
      "code": "<script setup lang=\"ts\">\nimport { DemoBlock, DemoNote, DemoSection } from '#components';\nimport { shallowRef } from 'vue';\nimport RebornSku from '~/components/reborn/ui/reborn-sku/RebornSku.vue';\n/** 选中结果：key 为属性组的 key，value 为选中项的 value 字段值（多选时为数组） */\nconst selected = shallowRef<Record<string, any>>({\n  color: \"black\",\n  size: \"M\",\n  services: [],\n});\n\n/** 商品规格配置：颜色 / 尺码为单选，增值服务为多选 */\nconst options = [\n  {\n    title: \"颜色\",\n    key: \"color\",\n    children: [\n      { label: \"曜石黑\", value: \"black\" },\n      { label: \"云雾白\", value: \"white\" },\n      { label: \"远峰蓝\", value: \"blue\" },\n    ],\n  },\n  {\n    title: \"尺码\",\n    key: \"size\",\n    children: [\n      { label: \"S\", value: \"S\" },\n      { label: \"M\", value: \"M\" },\n      { label: \"L\", value: \"L\" },\n      { label: \"XL\", value: \"XL\" },\n    ],\n  },\n  {\n    title: \"增值服务（可多选）\",\n    key: \"services\",\n    multiple: true,\n    children: [\n      { label: \"延保一年\", value: \"warranty\" },\n      { label: \"礼品包装\", value: \"gift\" },\n      { label: \"碎屏险\", value: \"screen\" },\n    ],\n  },\n];\n\n/** 自定义渲染场景：通过 #item 插槽附带展示价格 */\nconst priceSelected = shallowRef<Record<string, any>>({ plan: \"pro\" });\nconst priceOptions = [\n  {\n    title: \"套餐版本\",\n    key: \"plan\",\n    children: [\n      { label: \"基础版\", value: \"basic\", price: 199 },\n      { label: \"专业版\", value: \"pro\", price: 399 },\n      { label: \"旗舰版\", value: \"ultra\", price: 699 },\n    ],\n  },\n];\n\n/** 最近一次 change 事件的参数，展示在选中结果下方 */\nconst lastChange = shallowRef(\"\");\n\n/** 单个属性组选中值变化时触发 */\nfunction onChange(key: string, value: any) {\n  lastChange.value = `${key} → ${JSON.stringify(value)}`;\n}\n</script>\n\n<template>\n  <div class=\"flex w-full min-w-0 flex-col\">\n    <DemoSection\n      title=\"商品规格选择\"\n      description=\"单选 + 多选属性组，对象形式 v-model 收集选中结果。\"\n    >\n      <DemoBlock layout=\"stack\">\n        <RebornSku\n          v-model=\"selected\"\n          :options=\"options\"\n          @change=\"onChange\"\n        />\n        <DemoNote tone=\"dimmed\">\n          当前选中：{{ selected }}\n          <template v-if=\"lastChange\"> · 最近变化：{{ lastChange }}</template>\n        </DemoNote>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection\n      title=\"自定义选项渲染\"\n      description=\"#item 插槽拿到 item / option / selected，自行拼装内容。\"\n    >\n      <DemoBlock layout=\"stack\">\n        <RebornSku\n          v-model=\"priceSelected\"\n          :options=\"priceOptions\"\n        >\n          <template #item=\"{ item }\">\n            <span>{{ item.label }}</span>\n            <span class=\"ml-1 text-xs opacity-70\">¥{{ item.price }}</span>\n          </template>\n        </RebornSku>\n      </DemoBlock>\n    </DemoSection>\n  </div>\n</template>\n"
    }
  ],
  "related": [
    "reborn-badge"
  ],
  "whenToUse": [
    "商品详情页选择颜色、尺码等规格组合，需要 v-model 收集选中值。",
    "需要通过 item 插槽自定义规格选项的渲染。"
  ],
  "whenNotToUse": [
    "多层级联动选择（省市区、分类）改用 reborn-cascader。",
    "单组互斥选项改用 reborn-radio。",
    "uniapp 端项目：platforms 仅 web，无 uniapp 实现。"
  ],
  "pitfalls": [
    "platforms 仅 web 端提供。",
    "modelValue 为 Record<string, any> 对象（defineModel），change 与 update:modelValue 同步选中状态；不绑定 v-model 时组件自己持有选中结果，点选同样生效。",
    "无文档页与演示示例，props 描述缺失，SkuOption 具体结构需查阅源码（RebornSku.vue）。"
  ],
  "dependencies": [
    "clsx",
    "tailwind-merge",
    "tailwind-variants"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-sku"
  },
  "sourceRefs": {
    "web": [
      "app/components/reborn/ui/reborn-sku/RebornSku.vue",
      "app/components/reborn/ui/reborn-sku/reborn-sku.config.ts"
    ]
  },
