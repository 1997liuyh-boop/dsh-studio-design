      "title": "Web 演示 · RebornDatePickerPanelEventsDemo",
      "path": "app/components/reborn/examples/reborn-date-picker-panel/RebornDatePickerPanelEventsDemo.vue",
      "source": "demo",
      "platform": "web",
      "code": "<script setup lang=\"ts\">\n/**\n * 「事件」章节的卡片内容：面板、实例调用按钮与事件日志。\n * 章节标题与说明留在 RebornDatePickerPanelDemo.vue，文档站按那个文件抽取章节。\n */\nimport type { datePickerPanelColors, datePickerPanelSizes, ViewType } from \"~/components/reborn/ui/reborn-date-picker-panel/reborn-date-picker-panel.config\";\nimport { DemoBlock, DemoNote } from \"#components\";\nimport { shallowRef, useTemplateRef } from \"vue\";\nimport RebornButton from \"~/components/reborn/ui/reborn-button/RebornButton.vue\";\nimport RebornDatePickerPanel from \"~/components/reborn/ui/reborn-date-picker-panel/RebornDatePickerPanel.vue\";\nimport { formatPanelDisplay, useEventLog } from \"../_shared/date-demo-utils\";\n\ninterface Props {\n  /** 跟随演练场的配色 */\n  color: (typeof datePickerPanelColors)[number];\n  /** 跟随演练场的尺寸 */\n  size: (typeof datePickerPanelSizes)[number];\n}\nconst { color, size } = defineProps<Props>();\n\n/** 用于演示通过实例调用 clear() */\nconst eventPanel = useTemplateRef<InstanceType<typeof RebornDatePickerPanel>>(\"eventPanel\");\n\n/** 范围选择的值 */\nconst eventValue = shallowRef([\"2024-04-08\", \"2024-04-12\"]);\n\n/** 「事件」分组的日志保留最近 8 条 */\nconst { logs: eventLogs, push: pushLog, clear: clearLogs } = useEventLog(8);\n\n/** 范围类型点选日期，第一次点选时终点为 null */\nfunction onCalendarChange(value: [Date, Date | null]) {\n  pushLog(\"calendar-change\", `[${formatPanelDisplay(value[0])}, ${value[1] ? formatPanelDisplay(value[1]) : \"null\"}]`);\n}\n\n/** 面板翻页或切换视图 */\nfunction onPanelChange(date: Date | [Date, Date], mode: \"month\" | \"year\", view: ViewType) {\n  pushLog(\"panel-change\", `${formatPanelDisplay(date)}, \"${mode}\", \"${view}\"`);\n}\n\n/** 绑定值提交 */\nfunction onChange(value: unknown) {\n  pushLog(\"change\", formatPanelDisplay(value));\n}\n\n/** 调用 clear() 后触发 */\nfunction onClear() {\n  pushLog(\"clear\", \"()\");\n}\n</script>\n\n<template>\n  <DemoBlock layout=\"stack\">\n    <div class=\"flex min-w-0 flex-col gap-3\">\n      <RebornDatePickerPanel\n        ref=\"eventPanel\"\n        v-model=\"eventValue\"\n        type=\"daterange\"\n        value-format=\"YYYY-MM-DD\"\n        :color=\"color\"\n        :size=\"size\"\n        border\n        @calendar-change=\"onCalendarChange\"\n        @panel-change=\"onPanelChange\"\n        @change=\"onChange\"\n        @clear=\"onClear\"\n      />\n      <div class=\"flex flex-wrap items-center gap-2\">\n        <RebornButton size=\"sm\" variant=\"outlined\" @click=\"eventPanel?.clear()\">调用 clear()</RebornButton>\n        <RebornButton size=\"sm\" variant=\"soft\" color=\"neutral\" @click=\"clearLogs\">清空日志</RebornButton>\n      </div>\n      <DemoNote tone=\"dimmed\">\n        绑定值：<code>{{ formatPanelDisplay(eventValue) }}</code>\n      </DemoNote>\n      <ul class=\"flex flex-col gap-1 font-mono text-xs\">\n        <li v-for=\"log in eventLogs\" :key=\"log.id\" class=\"text-gray-7 break-all\">\n          <span class=\"text-primary\">{{ log.name }}</span>\n          {{ log.detail }}\n        </li>\n        <li v-if=\"!eventLogs.length\" class=\"text-gray-5\">点选日期、翻页或切换视图后，事件与参数会记录在这里。</li>\n      </ul>\n    </div>\n  </DemoBlock>\n</template>\n"
    },
    {
      "title": "Web 演示 · RebornDatePickerPanelPlaygroundDemo",
      "path": "app/components/reborn/examples/reborn-date-picker-panel/RebornDatePickerPanelPlaygroundDemo.vue",
      "source": "demo",
      "platform": "web",
      "code": "<script setup lang=\"ts\">\n/**\n * 日期面板演练场的预览区：只负责渲染面板、回显绑定值与最近一次事件。\n * Playground 外壳、配置状态与控制面板留在 RebornDatePickerPanelDemo.vue，文档站按那个文件抽取演练场标题。\n */\nimport type {\n  datePickerActiveTypes,\n  datePickerPanelColors,\n  datePickerPanelSizes,\n  DatePickerType,\n  ViewType,\n} from \"~/components/reborn/ui/reborn-date-picker-panel/reborn-date-picker-panel.config\";\nimport { DemoNote } from \"#components\";\nimport { shallowRef } from \"vue\";\nimport RebornDatePickerPanel from \"~/components/reborn/ui/reborn-date-picker-panel/RebornDatePickerPanel.vue\";\nimport { formatPanelDisplay } from \"../_shared/date-demo-utils\";\n\n/** 演练场的视觉与行为参数：由主演示文件持有，控制面板整体替换后经 config 传入 */\nexport interface DatePickerPanelPlaygroundConfig {\n  type: DatePickerType;\n  color: (typeof datePickerPanelColors)[number];\n  activeType: (typeof datePickerActiveTypes)[number];\n  width: \"auto\" | \"full\";\n  size: (typeof datePickerPanelSizes)[number];\n  disabled: boolean;\n  border: boolean;\n  /** 是否挂上快捷项 globalShortcuts */\n  shortcuts: boolean;\n  showWeekNumber: boolean;\n  unlinkPanels: boolean;\n  singlePanel: boolean;\n  showToday: boolean;\n  highlightToday: boolean;\n}\n\ninterface Props {\n  /** 演练场当前配置，只读 */\n  config: DatePickerPanelPlaygroundConfig;\n  /** 按选择类型推导的 value-format */\n  valueFormat: string;\n}\ndefineProps<Props>();\n\n/** 绑定值：切换类型与重置由主文件处理，这里只把选择结果写回 */\nconst value = defineModel<string | string[]>(\"value\", { required: true });\n\n/** 最近一次事件，让预览区的操作「有回应」 */\nconst lastEvent = shallowRef(\"\");\n\n/** 快捷选项：value 可以是日期，也可以是返回日期的函数 */\nconst globalShortcuts = [\n  { text: \"今天\", value: () => new Date() },\n  {\n    text: \"一周前\",\n    value: () => {\n      const d = new Date();\n      d.setDate(d.getDate() - 7);\n      return d;\n    },\n  },\n  {\n    text: \"下个月\",\n    value: () => {\n      const d = new Date();\n      d.setMonth(d.getMonth() + 1);\n      return d;\n    },\n  },\n];\n\n/** 范围类型点选日期，第一次点选时终点为 null */\nfunction onPlaygroundCalendarChange(range: [Date, Date | null]) {\n  lastEvent.value = `calendar-change ${formatPanelDisplay(range[0])} → ${range[1] ? formatPanelDisplay(range[1]) : \"null\"}`;\n}\n\n/** 面板翻页或切换视图 */\nfunction onPlaygroundPanelChange(date: Date | [Date, Date], mode: \"month\" | \"year\", view: ViewType) {\n  lastEvent.value = `panel-change ${formatPanelDisplay(date)} · mode=\"${mode}\" · view=\"${view}\"`;\n}\n\n/** 绑定值提交 */\nfunction onPlaygroundChange(next: unknown) {\n  lastEvent.value = `change ${formatPanelDisplay(next)}`;\n}\n</script>\n\n<template>\n  <div class=\"flex w-full flex-col items-center gap-4\">\n    <RebornDatePickerPanel\n      v-model=\"value\"\n      :type=\"config.type\"\n      :value-format=\"valueFormat\"\n      :color=\"config.color\"\n      :size=\"config.size\"\n      :active-type=\"config.activeType\"\n      :width=\"config.width\"\n      :border=\"config.border\"\n      :disabled=\"config.disabled\"\n      :shortcuts=\"config.shortcuts ? globalShortcuts : []\"\n      :show-week-number=\"config.showWeekNumber\"\n      :unlink-panels=\"config.unlinkPanels\"\n      :single-panel=\"config.singlePanel\"\n      :show-today=\"config.showToday\"\n      :highlight-today=\"config.highlightToday\"\n      @calendar-change=\"onPlaygroundCalendarChange\"\n      @panel-change=\"onPlaygroundPanelChange\"\n      @change=\"onPlaygroundChange\"\n    />\n\n    <DemoNote tone=\"dimmed\">\n      当前绑定值：<code class=\"break-all\">{{ formatPanelDisplay(value) }}</code>\n    </DemoNote>\n    <DemoNote tone=\"dimmed\">\n      最近事件：<code class=\"break-all\">{{ lastEvent || \"暂无\" }}</code>\n    </DemoNote>\n  </div>\n</template>\n"
    }
  ],
  "related": [
    "reborn-time-picker"
  ],
  "whenToUse": [
    "在 Popover、Modal 或页面内直接内嵌一个日期选择面板（不带输入框触发器）。",
    "需要 date/datetime/year/month 等多种类型（type）与快捷选项（shortcuts）的日期选择。",
    "需要 start/end 限制可选范围或用 disabledHours/Minutes/Seconds 精细禁用时间的场景。",
    "按周汇总的区间用 type=\"weekrange\"：起点吸附到所在周的周日、终点吸附到所在周的周六，绑定值直接是完整周的首尾两天。"
  ],
  "whenNotToUse": [
    "需要带触发器的表单日期字段，web 端改用 reborn-date-picker，uniapp 端改用 reborn-date-picker（底部弹出滚轮）。",
    "仅选择时间，改用 reborn-time-picker。"
  ],
  "pitfalls": [
    "仅 web 端可用（tags 中虽有 uniapp，platforms 实际只有 web）。",
    "是无触发器的纯面板：自身没有输入框，需要弹层时须自行包在 Popover/Modal 中。",
    "valueFormat 控制输出值格式；start 默认 1970-01-01、end 默认 2099-12-31。",
    "showToday 底部今天栏：范围类型写入 [今天, 今天]（datetimerange 起止时间为 00:00:00 与 23:59:59），多选类型只追加不取消，今天被 start/end/disabledMethod 排除或面板 disabled 时置灰不可点。",
    "defaultValue 只定位未选值时的视图，不写入绑定值；数组时第一项定位左面板，仅 unlinkPanels 下第二项定位右面板。",
    "服务端渲染首帧不读取今天：未传绑定值与 defaultValue 时内部停在固定基准月（1970 年 1 月），首帧主内容区为 visibility: hidden（只占位），挂载后切到本地当前月再显示；首屏要直接显示业务月份须传 defaultValue 或绑定值。"
  ],
  "dependencies": [
    "clsx",
    "dayjs",
    "tailwind-merge",
    "tailwind-variants"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-date-picker-panel"
  },
