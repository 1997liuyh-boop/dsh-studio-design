{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-form",
  "title": "Form 表单",
  "description": "用于组织表单项并基于 zod schema 校验数据的表单容器组件，双端可用。",
  "category": "form",
  "tags": [
    "vue",
    "reborn-form",
    "uniapp"
  ],
  "aliases": [
    "form",
    "表单",
    "表单校验"
  ],
  "platforms": [
    "web",
    "uniapp"
  ],
  "props": [
    {
      "name": "customClass",
      "type": "ClassValue",
      "required": false,
      "description": "**仅 UniApp**。追加到根节点的自定义类名。",
      "default": "\"\""
    },
    {
      "name": "modelValue",
      "type": "any",
      "required": true,
      "description": "表单数据对象，通常使用 `v-model` 或 `:model-value` 绑定。",
      "default": "() => ({})"
    },
    {
      "name": "rules",
      "type": "z.ZodObject<{ [key: string]: any }, any>",
      "required": false,
      "description": "表单验证规则，基于 `zod` schema（web 端还支持 `z.ZodEffects`），不是 Element 风格的规则数组。",
      "default": "undefined"
    },
    {
      "name": "labelPosition",
      "type": "typeof formLabelPositions[number]",
      "required": false,
      "description": "标签位置",
      "default": "'left'"
    },
    {
      "name": "labelWidth",
      "type": "string | number",
      "required": false,
      "description": "标签宽度",
      "default": "'140rpx'"
    },
    {
      "name": "showMessage",
      "type": "boolean",
      "required": false,
      "description": "是否显示错误信息",
      "default": "true"
    },
    {
      "name": "inlineMessage",
      "type": "boolean",
      "required": false,
      "description": "是否内联显示错误信息",
      "default": "true"
    },
    {
      "name": "size",
      "type": "'' | 'sm' | 'md' | 'lg'",
      "required": false,
      "description": "表单大小",
      "default": "'md'"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "description": "是否禁用",
      "default": "false"
    },
    {
      "name": "scrollToError",
      "type": "boolean",
      "required": false,
      "description": "是否滚动到错误信息",
      "default": "true"
    },
    {
      "name": "trigger",
      "type": "'blur' | 'change' | 'none' | Array<'blur' | 'change'>",
      "required": false,
      "description": "触发验证",
      "default": "'none'"
    },
    {
      "name": "ui",
      "type": "Partial<{\n    root: ClassValue\n  }>",
      "required": false,
      "description": "覆盖内部各区域样式类，目前仅支持 root（根节点） 可用键（从源码抽取，以此为准）——两端：RebornForm → root；RebornFormItem → content、error、label、root、wrapper。",
      "default": "{}"
    },
    {
      "name": "prop",
      "type": "string",
      "required": false,
      "description": "表单域对应的数据字段名；使用 `validate` / `resetFields` 等方法时该属性必填。",
      "default": "''"
    },
    {
      "name": "label",
      "type": "string",
      "required": false,
      "description": "标签文本。",
      "default": "''"
    },
    {
      "name": "required",
      "type": "boolean",
      "required": false,
      "description": "是否显示必填星号（仅展示用途，校验规则仍由 `rules` 决定）。",
      "default": "false"
    },
    {
      "name": "requireAsteriskPosition",
      "type": "'left' | 'right'",
      "required": false,
      "description": "标签位置",
      "default": "'right'"
    },
    {
      "name": "class",
      "type": "any",
      "required": false,
      "description": "追加到根 form 元素的自定义类名（uniapp 端对应 customClass）",
      "default": "\"\""
    }
  ],
  "events": [],
  "slots": [
    {
      "name": "default",
      "description": "表单内容，通常放置若干 `RebornFormItem`。"
    },
    {
      "name": "label",
      "description": "自定义标签区域，替代 `label` 文本与必填星号。"
    }
  ],
  "exposes": [
    {
      "name": "validate",
      "description": "`(callback?: (valid, errors) => void) => Promise<boolean>` 校验整个表单；Promise 始终 resolve 是否通过（不 reject），失败且 scrollToError 开启时自动滚动到第一个错误字段"
    },
    {
      "name": "validateField",
      "description": "`(prop: string) => Promise<string | null>` 校验单个字段（支持 `contacts-0-name` 形式的嵌套路径），返回错误信息，通过时为 null"
    },
    {
      "name": "clearValidate",
      "description": "`(props?: string | string[]) => void` 清除校验错误提示；不传清除全部字段，传字段名或数组仅清除对应字段（不重置值）"
    },
    {
      "name": "resetFields",
      "description": "`() => void` 将所有字段重置为初始值快照（挂载时自动记录）并清除全部校验结果"
    },
    {
      "name": "scrollToField",
      "description": "`(prop: string) => void` 滚动页面使指定字段进入视口居中位置（H5 平滑滚动，小程序/APP 使用 pageScrollTo）"
    },
    {
      "name": "fields",
      "description": "已注册字段名（prop）的 Set 集合，只读，用于检查字段注册情况"
    },
    {
      "name": "getField",
      "description": "`(prop: string) => 实例 | undefined` 按 prop 获取已注册的 FormItem 字段实例"
    },
    {
      "name": "setInitialValues",
      "description": "`(values: any) => void` 重设 resetFields 使用的初始值快照（深拷贝存储，挂载时已自动记录一次）"
    },
    {
      "name": "prop",
      "description": "当前表单项绑定的字段名，供父级 Form 定位字段实例（validateField/scrollToField 等依赖它）"
    },
    {
      "name": "getBoundingClientRect",
      "description": "`(callback: (rect) => void) => void` 以回调返回表单项根节点的位置与尺寸（基于 uni.createSelectorQuery），校验失败滚动定位时使用"
    }
  ],
  "examples": [
    {
      "title": "Web 演示 · RebornFormDemo",
      "path": "app/components/reborn/examples/reborn-form/RebornFormDemo.vue",
      "source": "demo",
      "platform": "web",
      "code": "<script setup lang=\"ts\">\nimport type {FormData} from \"./reborn-form-demo.config\";\nimport { DemoBlock, DemoNote, DemoSection, Icon, Playground } from \"#components\";\nimport { computed, nextTick, reactive, shallowRef, useTemplateRef } from 'vue';\nimport RebornButton from \"~/components/reborn/ui/reborn-button/RebornButton.vue\";\nimport RebornCheckboxGroup from \"~/components/reborn/ui/reborn-checkbox/RebornCheckboxGroup.vue\";\nimport RebornDatePicker from \"~/components/reborn/ui/reborn-date-picker/RebornDatePicker.vue\";\nimport { formLabelPositions } from \"~/components/reborn/ui/reborn-form/reborn-form.config\";\nimport RebornForm from \"~/components/reborn/ui/reborn-form/RebornForm.vue\";\nimport RebornFormItem from \"~/components/reborn/ui/reborn-form/RebornFormItem.vue\";\nimport RebornInputNumber from \"~/components/reborn/ui/reborn-input-number/RebornInputNumber.vue\";\nimport RebornInput from \"~/components/reborn/ui/reborn-input/RebornInput.vue\";\nimport RebornSelect from \"~/components/reborn/ui/reborn-select/RebornSelect.vue\";\nimport RebornSlider from \"~/components/reborn/ui/reborn-slider/RebornSlider.vue\";\nimport RebornSwitch from \"~/components/reborn/ui/reborn-switch/RebornSwitch.vue\";\nimport RebornTextarea from \"~/components/reborn/ui/reborn-textarea/RebornTextarea.vue\";\nimport { createInitialForm, createRules, genderOptions, interestOptions } from \"./reborn-form-demo.config\";\nimport RebornFormLinkageDemo from \"./RebornFormLinkageDemo.vue\";\n\n// ─── 交互演练场 ─────────────────────────────────────────────────\n\nconst formRef = useTemplateRef<InstanceType<typeof RebornForm>>(\"formRef\");\n\nconst state = shallowRef<Record<string, any>>({\n  labelPosition: \"right\",\n  labelWidth: \"80px\",\n  size: \"md\",\n  immediateValidate: true,\n  requireAsteriskPosition: \"right\",\n  showMessage: true,\n  inlineMessage: false,\n  disabled: false,\n});\n\n/** 演练场控制面板配置 */\nconst controls = [\n  {\n    title: \"标签与尺寸\",\n    children: [\n      {\n        label: \"标签位置\",\n        key: \"labelPosition\",\n        component: \"select\" as const,\n        defaultValue: \"right\",\n        props: { options: formLabelPositions.map((p) => ({ label: p, value: p })) },\n      },\n      {\n        label: \"标签宽度\",\n        key: \"labelWidth\",\n        component: \"input\" as const,\n        defaultValue: \"80px\",\n      },\n      {\n        label: \"尺寸规格\",\n        key: \"size\",\n        component: \"select\" as const,\n        defaultValue: \"md\",\n        props: {\n          options: [\n            { label: \"SM\", value: \"sm\" },\n            { label: \"MD\", value: \"md\" },\n            { label: \"LG\", value: \"lg\" },\n          ],\n        },\n      },\n    ],\n  },\n  {\n    title: \"校验与提示\",\n    children: [\n      {\n        label: \"实时校验（change + blur）\",\n        key: \"immediateValidate\",\n        component: \"checkbox\" as const,\n        defaultValue: true,\n      },\n      {\n        label: \"星号位置\",\n        key: \"requireAsteriskPosition\",\n        component: \"select\" as const,\n        defaultValue: \"right\",\n        props: {\n          options: [\n            { label: \"标签右侧 right\", value: \"right\" },\n            { label: \"标签左侧 left\", value: \"left\" },\n          ],\n        },\n      },\n      { label: \"显示错误信息\", key: \"showMessage\", component: \"checkbox\" as const, defaultValue: true },\n      { label: \"行内错误提示\", key: \"inlineMessage\", component: \"checkbox\" as const, defaultValue: false },\n      { label: \"整体禁用\", key: \"disabled\", component: \"checkbox\" as const, defaultValue: false },\n    ],\n  },\n];\n\n/** 演练场右上角展示的等价代码 */\nconst formCode = computed(() => {\n  const s = state.value;\n  const props: string[] = [':model-value=\"form\"', ':rules=\"rules\"'];\n\n  if (s.labelPosition !== \"left\") props.push(`label-position=\"${s.labelPosition}\"`);\n  if (s.labelWidth !== \"140px\") props.push(`label-width=\"${s.labelWidth}\"`);\n  if (s.size !== \"md\") props.push(`size=\"${s.size}\"`);\n  props.push(`:trigger=\"${s.immediateValidate ? \"['change', 'blur']\" : \"'none'\"}\"`);\n  if (!s.showMessage) props.push(':show-message=\"false\"');\n  if (s.inlineMessage) props.push(\"inline-message\");\n  if (s.disabled) props.push(\"disabled\");\n\n  return `<RebornForm\\n  ${props.join(\"\\n  \")}\\n>\\n  <RebornFormItem prop=\"username\" label=\"用户名\" required require-asterisk-position=\"${s.requireAsteriskPosition}\">\\n    <RebornInput v-model=\"form.username\" />\\n  </RebornFormItem>\\n</RebornForm>`;\n});\n\n// ─── 表单数据与校验 ─────────────────────────────────────────────\n\nconst form = reactive<FormData>(createInitialForm());\n\n/** refine 在校验时才读取当前密码，规则只需创建一次。 */\nconst rules = createRules(form);\n\n/** trigger 为 'none' 时只在手动调用 validate() 时校验 */\nconst formTrigger = computed<\"none\" | Array<\"blur\" | \"change\">>(() =>\n  state.value.immediateValidate ? [\"change\", \"blur\"] : \"none\",\n);\n\n/** 最近一次提交结果，替代 alert 与 console 输出 */\nconst lastResult = shallowRef<\"\" | \"success\" | \"fail\">(\"\");\n\n/** 最近一次校验失败的字段数量 */\nconst errorCount = shallowRef(0);\n\nlet contactSeed = 0;\n\n/** 联系人身份不依赖数组下标，删除后仍能保留输入实例。 */\nfunction addContact() {\n  form.contacts.push({\n    id: ++contactSeed,\n    phone: \"\",\n    email: \"\",\n    name: \"\",\n    no: form.contacts.length + 1,\n  });\n}\n\n/** 路径随索引变化前清除联系人校验，防止旧错误或在途校验落到下一行。 */\nasync function removeContact(index: number) {\n  const fields = [...(formRef.value?.fields || [])].filter(prop => prop === \"contacts\" || prop.startsWith(\"contacts-\"));\n  formRef.value?.clearValidate(fields);\n  form.contacts.splice(index, 1);\n  lastResult.value = \"\";\n  errorCount.value = 0;\n  await nextTick();\n  if (state.value.immediateValidate) {\n    await Promise.all([...formRef.value?.fields || []].filter(prop => prop === \"contacts\" || prop.startsWith(\"contacts-\")).map(prop => formRef.value?.validateField(prop)));\n  }\n}\n\nasync function submit() {\n  if (!formRef.value) return;\n\n  const valid = await formRef.value.validate((isValid, errors) => {\n    errorCount.value = isValid ? 0 : errors.length;\n  });\n\n  lastResult.value = valid ? \"success\" : \"fail\";\n}\n\nfunction reset() {\n  formRef.value?.resetFields();\n  lastResult.value = \"\";\n  errorCount.value = 0;\n}\n\n/** 校验失败时可用 scrollToField 把出错项滚动进视口 */\nfunction scrollToBio() {\n  formRef.value?.scrollToField(\"bio\");\n}\n</script>\n\n<template>\n  <div class=\"flex w-full min-w-0 flex-col\">\n    <Playground\n      v-model=\"state\" :controls=\"controls\" :code=\"formCode\" component-name=\"RebornForm\" title=\"交互演练场\"\n      description=\"校验规则由 Zod 描述；trigger 决定是输入即校验还是仅在提交时校验，label-width 仅在标签左右布局时生效。\"\n    >\n      <div class=\"py-2 w-150\">\n        <RebornForm\n          ref=\"formRef\" :model-value=\"form\" :rules=\"rules\" :label-width=\"state.labelWidth\"\n          :label-position=\"state.labelPosition\" :size=\"state.size\" :trigger=\"formTrigger\"\n          :show-message=\"state.showMessage\" :inline-message=\"state.inlineMessage\" :disabled=\"state.disabled\"\n        >\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"username\" label=\"用户名\" required>\n            <RebornInput v-model=\"form.username\" placeholder=\"请输入用户名\" />\n          </RebornFormItem>\n\n          <!-- 复选框组接管数组值与布局，并通过表单注入继承尺寸/禁用、在勾选时触发校验 -->\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"interest\" label=\"兴趣爱好\" required>\n            <RebornCheckboxGroup v-model=\"form.interest\" :options=\"interestOptions\" />\n          </RebornFormItem>\n\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"gender\" label=\"性别\" required>\n            <RebornSelect v-model=\"form.gender\" :options=\"genderOptions\" placeholder=\"请选择性别\" />\n          </RebornFormItem>\n\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"birthday\" label=\"出生年月\" required>\n            <RebornDatePicker v-model=\"form.birthday\" type=\"date\" value-format=\"YYYY-MM-DD\" placeholder=\"请选择出生年月\" />\n          </RebornFormItem>\n\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"dateRange\" label=\"入职时间\" required>\n            <RebornDatePicker\n              v-model=\"form.dateRange\" type=\"daterange\" start-placeholder=\"起始日期\" end-placeholder=\"结束日期\"\n              value-format=\"YYYY-MM-DD\"\n            />\n          </RebornFormItem>\n\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"isAgree\" label=\"是否同意\" required>\n            <div class=\"flex items-center gap-4\">\n              <RebornSwitch v-model=\"form.isAgree\" />\n              <span class=\"text-muted text-sm\">同意《用户服务协议》</span>\n            </div>\n          </RebornFormItem>\n\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"password\" label=\"密码\" required>\n            <RebornInput v-model=\"form.password\" placeholder=\"请输入密码\" password />\n          </RebornFormItem>\n\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"newPassword\" label=\"新密码\" required>\n            <RebornInput v-model=\"form.newPassword\" placeholder=\"再次确认新密码\" password />\n          </RebornFormItem>\n\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"email\" label=\"验证邮箱\" required>\n            <RebornInput v-model=\"form.email\" placeholder=\"example@domain.com\" />\n          </RebornFormItem>\n\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"age\" label=\"年龄\" required>\n            <RebornInputNumber v-model=\"form.age\" placeholder=\"18-100\" />\n          </RebornFormItem>\n\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"height\" label=\"身高\" required>\n            <div class=\"flex w-full items-center gap-4\">\n              <RebornSlider v-model=\"form.height\" :min=\"140\" :max=\"220\" class=\"flex-1\" />\n              <span class=\"text-muted w-12 font-mono text-sm\">{{ form.height }}cm</span>\n            </div>\n          </RebornFormItem>\n\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"weight\" label=\"体重\" required>\n            <div class=\"flex w-full items-center gap-4\">\n              <RebornSlider v-model=\"form.weight\" :min=\"30\" :max=\"150\" class=\"flex-1\" />\n              <span class=\"text-muted w-12 font-mono text-sm\">{{ form.weight }}kg</span>\n            </div>\n          </RebornFormItem>\n\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"bio\" label=\"个人简介\">\n            <RebornTextarea v-model=\"form.bio\" placeholder=\"请输入简介 (至少10个字符，选填)\" />\n          </RebornFormItem>\n\n          <!-- 嵌套动态列表：prop 以 contacts-索引-字段 的形式与 Zod 数组规则对应 -->\n          <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" prop=\"contacts\" required label-position=\"top\">\n            <template #label>\n              <div class=\"mb-2 flex w-full items-center justify-between\">\n                <span class=\"text-highlighted text-sm font-semibold\">联系人列表</span>\n                <RebornButton size=\"sm\" variant=\"outlined\" label=\"添加联系人\" @click=\"addContact\">\n                  <template #leading>\n                    <Icon name=\"lucide:plus\" />\n                  </template>\n                </RebornButton>\n              </div>\n            </template>\n\n            <div\n              v-for=\"(contact, index) in form.contacts\" :key=\"contact.id\"\n              class=\"border-default rounded-xl mb-4 flex flex-col border p-4\"\n            >\n              <div class=\"border-default mb-4 flex items-center justify-between border-b pb-3\">\n                <span class=\"text-default text-sm font-medium\">#{{ index + 1 }} 联系人信息</span>\n                <RebornButton variant=\"text\" color=\"neutral\" size=\"sm\" @click=\"removeContact(index)\">\n                  <Icon name=\"lucide:trash-2\" />\n                </RebornButton>\n              </div>\n\n              <div class=\"grid grid-cols-1 gap-x-8 md:grid-cols-2\">\n                <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" :prop=\"`contacts-${index}-name`\" label=\"姓名\" required label-position=\"top\">\n                  <RebornInput v-model=\"contact.name\" placeholder=\"请输入姓名\" />\n                </RebornFormItem>\n                <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" :prop=\"`contacts-${index}-phone`\" label=\"手机号\" required label-position=\"top\">\n                  <RebornInput v-model=\"contact.phone\" placeholder=\"1XXXXXXXXXX\" />\n                </RebornFormItem>\n                <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" :prop=\"`contacts-${index}-email`\" label=\"邮箱\" required label-position=\"top\">\n                  <RebornInput v-model=\"contact.email\" placeholder=\"example@domain.com\" />\n                </RebornFormItem>\n                <RebornFormItem :require-asterisk-position=\"state.requireAsteriskPosition\" :prop=\"`contacts-${index}-no`\" label=\"序号\" required label-position=\"top\">\n                  <RebornInputNumber v-model=\"contact.no\" placeholder=\"用于递增校验\" />\n                </RebornFormItem>\n              </div>\n            </div>\n          </RebornFormItem>\n\n          <div class=\"border-default mt-6 flex flex-wrap gap-3 border-t pt-6\">\n            <RebornButton label=\"提交表单\" @click=\"submit\" />\n            <RebornButton variant=\"outlined\" label=\"重置\" @click=\"reset\" />\n            <RebornButton variant=\"soft\" color=\"neutral\" label=\"滚动到简介\" @click=\"scrollToBio\" />\n          </div>\n\n          <DemoNote tone=\"dimmed\">\n            <template v-if=\"lastResult === 'success'\">\n              校验通过，<code>validate()</code> 返回 <code>true</code>。\n            </template>\n            <template v-else-if=\"lastResult === 'fail'\">\n              校验未通过，共 <code>{{ errorCount }}</code> 个字段存在错误；联系人至少需要 3\n              个且序号必须递增。\n            </template>\n            <template v-else>\n              点击「提交表单」触发一次全量校验；<code>scrollToField</code> 可把指定字段滚动进视口。\n            </template>\n          </DemoNote>\n        </RebornForm>\n      </div>\n    </Playground>\n\n    <DemoSection title=\"完整表单联动\" class=\"relative z-10\">\n      <template #description>\n        多种控件共享同一份表单数据；举办方式与通知开关同步调整字段、<code>rules</code> 和必填完成度。\n      </template>\n      <DemoBlock layout=\"stack\">\n        <RebornFormLinkageDemo />\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection title=\"实时数据\" description=\"v-model 绑定的对象随输入同步更新，可直接观察 Zod 预处理后的取值类型。\">\n      <pre\n        class=\"border-default rounded-lg text-muted max-h-96 overflow-auto border p-4 font-mono text-xs leading-relaxed\"\n      >\n      {{ JSON.stringify(form, null, 2) }}</pre>\n    </DemoSection>\n  </div>\n</template>\n"
    },
    {
      "title": "Web 演示 · RebornFormLinkageDemo",
      "path": "app/components/reborn/examples/reborn-form/RebornFormLinkageDemo.vue",
      "source": "demo",
      "platform": "web",
      "code": "<script setup lang=\"ts\">\nimport { computed, nextTick, reactive, shallowRef, useTemplateRef, watch } from 'vue';\nimport { z } from 'zod';\nimport RebornButton from '~/components/reborn/ui/reborn-button/RebornButton.vue';\nimport RebornCheckbox from '~/components/reborn/ui/reborn-checkbox/RebornCheckbox.vue';\nimport RebornCheckboxGroup from '~/components/reborn/ui/reborn-checkbox/RebornCheckboxGroup.vue';\nimport RebornColorPicker from '~/components/reborn/ui/reborn-color-picker/RebornColorPicker.vue';\nimport RebornDatePicker from '~/components/reborn/ui/reborn-date-picker/RebornDatePicker.vue';\nimport RebornForm from '~/components/reborn/ui/reborn-form/RebornForm.vue';\nimport RebornFormItem from '~/components/reborn/ui/reborn-form/RebornFormItem.vue';\nimport RebornInputNumber from '~/components/reborn/ui/reborn-input-number/RebornInputNumber.vue';\nimport RebornInput from '~/components/reborn/ui/reborn-input/RebornInput.vue';\nimport RebornMention from '~/components/reborn/ui/reborn-mention/RebornMention.vue';\nimport RebornProgress from '~/components/reborn/ui/reborn-progress/RebornProgress.vue';\nimport RebornRadioGroup from '~/components/reborn/ui/reborn-radio/RebornRadioGroup.vue';\nimport RebornRate from '~/components/reborn/ui/reborn-rate/RebornRate.vue';\nimport RebornSelect from '~/components/reborn/ui/reborn-select/RebornSelect.vue';\nimport RebornSlider from '~/components/reborn/ui/reborn-slider/RebornSlider.vue';\nimport RebornSwitch from '~/components/reborn/ui/reborn-switch/RebornSwitch.vue';\nimport RebornTextarea from '~/components/reborn/ui/reborn-textarea/RebornTextarea.vue';\nimport RebornTimePicker from '~/components/reborn/ui/reborn-time-picker/RebornTimePicker.vue';\n\n/** 综合示例的数据独立于上方演练场，重置时互不影响。 */\nconst form = reactive({\n  title: '',\n  category: 'sharing',\n  mode: 'online',\n  capacity: 20,\n  city: 'hangzhou',\n  venue: null as string | null,\n  meetingUrl: '',\n  date: '',\n  time: '',\n  topics: [] as string[],\n  notifications: false,\n  email: '',\n  rating: 0,\n  description: '',\n  collaborators: '',\n  themeColor: '#1b6dfa',\n  agreed: false,\n});\n\n/** 表单实例与提交回显；编辑后清除旧的提交快照，避免误认为新值已经提交。 */\nconst formRef = useTemplateRef<InstanceType<typeof RebornForm>>(\"formRef\");\nconst result = shallowRef<'idle' | 'success' | 'error'>('idle');\nconst errorCount = shallowRef(0);\nconst submitted = shallowRef('');\n\n/** 下拉、单选、复选与提及的候选项。 */\nconst categoryOptions = [\n  { label: '主题分享', value: 'sharing' },\n  { label: '动手工作坊', value: 'workshop' },\n];\nconst modeOptions = [\n  { label: '线上活动', value: 'online' },\n  { label: '线下活动', value: 'offline' },\n];\nconst cityOptions = [\n  { label: '杭州', value: 'hangzhou' },\n  { label: '上海', value: 'shanghai' },\n];\nconst venues: Record<string, { label: string; value: string }[]> = {\n  hangzhou: [{ label: '西湖交流空间', value: 'westlake' }, { label: '滨江创作室', value: 'binjiang' }],\n  shanghai: [{ label: '徐汇交流空间', value: 'xuhui' }, { label: '浦东创作室', value: 'pudong' }],\n};\nconst topicOptions = [\n  { label: '组件设计', value: 'components' },\n  { label: '交互体验', value: 'interaction' },\n  { label: '无障碍', value: 'accessibility' },\n];\nconst collaboratorOptions = [\n  { label: '小林 · 主持人', value: '小林' },\n  { label: '小周 · 设计师', value: '小周' },\n  { label: '小陈 · 开发者', value: '小陈' },\n];\n\n/** 工作坊最多 20 人，线下分享最多 30 人，线上分享最多 100 人。 */\nconst capacityLimit = computed(() => form.category === 'workshop' ? 20 : form.mode === 'offline' ? 30 : 100);\n/** 城市决定场地候选项，切换后不保留已经失效的场地。 */\nconst venueOptions = computed(() => venues[form.city] ?? []);\n\n/** 禁用或隐藏字段同时放宽规则；必填星号和进度使用相同的业务条件。 */\nconst rules = computed(() => z.object({\n  title: z.string().trim().min(2, '请填写至少 2 个字的活动名称'),\n  category: z.enum(['sharing', 'workshop']),\n  mode: z.enum(['online', 'offline']),\n  capacity: z.number().int('人数须为整数').min(1, '至少需要 1 人').max(capacityLimit.value, `最多 ${capacityLimit.value} 人`),\n  city: z.string(),\n  venue: form.mode === 'offline'\n    ? z.string({ invalid_type_error: '请选择活动场地' }).refine(value => venueOptions.value.some(item => item.value === value), '请选择当前城市的场地')\n    : z.string().nullable(),\n  meetingUrl: form.mode === 'online'\n    ? z.string().url('请填写完整的会议链接').refine(value => /^https?:\\/\\//.test(value), '会议链接须以 http:// 或 https:// 开头')\n    : z.string(),\n  date: z.preprocess(value => value ?? '', z.string().min(1, '请选择活动日期')),\n  time: z.string().regex(/^([01]\\d|2[0-3]):[0-5]\\d$/, '请选择开始时间'),\n  topics: z.array(z.string()).min(1, '请至少选择一个关注主题'),\n  notifications: z.boolean(),\n  email: form.notifications ? z.string().trim().email('请填写有效的通知邮箱') : z.string(),\n  rating: z.number().min(1, '请选择期待程度').max(5),\n  description: z.string().trim().min(10, '活动介绍至少需要 10 个字').max(200),\n  collaborators: z.string(),\n  themeColor: z.string(),\n  agreed: z.boolean().refine(value => value, '请先确认活动信息'),\n}));\n\n/** 用同一份校验规则计算必填完成度，条件字段只在启用时计入。 */\nconst completion = computed(() => {\n  const fields = ['title', 'category', 'mode', 'capacity', 'date', 'time', 'topics', 'rating', 'description', 'agreed',\n    ...(form.mode === 'online' ? ['meetingUrl'] : ['city', 'venue']), ...(form.notifications ? ['email'] : [])];\n  const parsed = rules.value.safeParse(form);\n  const invalid = new Set(parsed.success ? [] : parsed.error.issues.map(issue => String(issue.path[0])));\n  const completed = fields.filter(field => !invalid.has(field)).length;\n  return { completed, total: fields.length, percent: Math.round(completed / fields.length * 100) };\n});\n\n/** 规格改变后收紧人数上限，输入框与滑块始终绑定同一个值。 */\nwatch(capacityLimit, limit => {\n  form.capacity = Math.min(form.capacity, limit);\n});\n/** 清除不再适用的字段值和校验提示，隐藏字段不会阻止提交。 */\nwatch(() => form.mode, mode => {\n  if (mode === 'online') form.venue = null;\n  else form.meetingUrl = '';\n  formRef.value?.clearValidate(['venue', 'meetingUrl']);\n});\nwatch(() => form.city, () => {\n  if (!venueOptions.value.some(item => item.value === form.venue)) form.venue = null;\n  formRef.value?.clearValidate('venue');\n});\nwatch(() => form.notifications, enabled => {\n  if (!enabled) form.email = '';\n  formRef.value?.clearValidate('email');\n});\nwatch(form, () => {\n  result.value = 'idle';\n  submitted.value = '';\n  errorCount.value = 0;\n});\n\n/** 时间、评分尚未自动接入字段校验，等模型写回后手动校验对应字段。 */\nasync function validateField(field: string) {\n  await nextTick();\n  await formRef.value?.validateField(field);\n}\n\n/** 填入可通过校验的数据，便于观察完整状态和再次编辑后的联动。 */\nasync function fillExample() {\n  Object.assign(form, {\n    title: '周末组件交流会', category: 'sharing', mode: 'online', capacity: 40,\n    city: 'hangzhou', venue: null, meetingUrl: 'https://example.com/meeting',\n    date: '2026-11-21', time: '14:00', topics: ['components', 'interaction'],\n    notifications: true, email: 'organizer@example.com', rating: 4,\n    description: '一起交流组件设计与表单交互，分享真实项目中的实践经验。',\n    collaborators: '请 @小林 主持，邀请 @小周 分享设计经验。', themeColor: '#1b6dfa', agreed: true,\n  });\n  await nextTick();\n  formRef.value?.clearValidate();\n}\n\n/** 仅做本地校验与数据回显，不向外部发送报名信息。 */\nasync function submit() {\n  const valid = await formRef.value?.validate((_valid, errors) => {\n    errorCount.value = errors.length;\n  });\n  result.value = valid ? 'success' : 'error';\n  submitted.value = valid ? JSON.stringify(form, null, 2) : '';\n}\n\n/** 恢复挂载时的初始值，同时清除校验和提交回显。 */\nasync function reset() {\n  formRef.value?.resetFields();\n  await nextTick();\n  formRef.value?.clearValidate();\n  result.value = 'idle';\n  errorCount.value = 0;\n  submitted.value = '';\n}\n</script>\n\n<template>\n  <div class=\"w-full min-w-0 space-y-6\" data-form-linkage>\n    <div class=\"flex flex-wrap items-start justify-between gap-4\">\n      <div class=\"space-y-1\">\n        <h3 class=\"text-highlighted text-xl font-semibold\">活动报名设置</h3>\n        <p class=\"text-muted text-sm\">切换举办方式、活动类型和通知开关，观察字段、人数上限与校验规则同步变化。</p>\n      </div>\n      <RebornButton variant=\"soft\" size=\"sm\" @click=\"fillExample\">填入示例</RebornButton>\n    </div>\n\n    <div class=\"bg-elevated space-y-2 rounded-lg p-4\">\n      <div class=\"flex items-center justify-between gap-3 text-sm\">\n        <span>必填完成度</span>\n        <span aria-live=\"polite\">{{ completion.completed }} / {{ completion.total }} 项 · {{ completion.percent }}%</span>\n      </div>\n      <RebornProgress :percent=\"completion.percent\" :status=\"completion.percent === 100 ? 'success' : 'default'\" :show-text=\"false\" aria-label=\"必填完成度\" />\n    </div>\n\n    <RebornForm ref=\"formRef\" :model-value=\"form\" :rules=\"rules\" label-position=\"top\" size=\"md\" :trigger=\"['change', 'blur']\">\n      <div class=\"grid min-w-0 grid-cols-1 gap-x-6 md:grid-cols-2\">\n        <RebornFormItem prop=\"title\" label=\"活动名称\" required>\n          <RebornInput v-model=\"form.title\" placeholder=\"例如：周末组件交流会\" clearable />\n        </RebornFormItem>\n        <RebornFormItem prop=\"category\" label=\"活动类型\" required>\n          <RebornSelect v-model=\"form.category\" :options=\"categoryOptions\" :clearable=\"false\" />\n        </RebornFormItem>\n        <RebornFormItem prop=\"mode\" label=\"举办方式\" required>\n          <RebornRadioGroup v-model=\"form.mode\" :options=\"modeOptions\" />\n        </RebornFormItem>\n        <RebornFormItem prop=\"capacity\" label=\"报名人数上限\" required>\n          <div class=\"w-full space-y-3\">\n            <RebornInputNumber v-model=\"form.capacity\" :min=\"1\" :max=\"capacityLimit\" :value-on-clear=\"1\" />\n            <RebornSlider v-model=\"form.capacity\" :min=\"1\" :max=\"capacityLimit\" />\n            <p class=\"text-muted text-sm\">两种输入同步；当前最多 {{ capacityLimit }} 人，切换活动类型或方式会自动收紧人数。</p>\n          </div>\n        </RebornFormItem>\n\n        <RebornFormItem v-if=\"form.mode === 'online'\" key=\"meetingUrl\" prop=\"meetingUrl\" label=\"线上会议链接\" required class=\"md:col-span-2\">\n          <RebornInput v-model=\"form.meetingUrl\" placeholder=\"https://example.com/meeting\" />\n        </RebornFormItem>\n        <template v-else>\n          <RebornFormItem key=\"city\" prop=\"city\" label=\"活动城市\" required>\n            <RebornSelect v-model=\"form.city\" :options=\"cityOptions\" :clearable=\"false\" />\n          </RebornFormItem>\n          <RebornFormItem key=\"venue\" prop=\"venue\" label=\"活动场地\" required>\n            <RebornSelect v-model=\"form.venue\" :options=\"venueOptions\" placeholder=\"请先选择城市，再选择场地\" clearable />\n          </RebornFormItem>\n        </template>\n\n        <RebornFormItem prop=\"date\" label=\"活动日期\" required>\n          <RebornDatePicker v-model=\"form.date\" type=\"date\" value-format=\"YYYY-MM-DD\" placeholder=\"请选择活动日期\" />\n        </RebornFormItem>\n        <RebornFormItem prop=\"time\" label=\"开始时间\" required>\n          <RebornTimePicker v-model=\"form.time\" format=\"HH:mm\" placeholder=\"请选择开始时间\" @change=\"validateField('time')\" />\n        </RebornFormItem>\n        <RebornFormItem prop=\"topics\" label=\"关注主题\" required class=\"md:col-span-2\">\n          <RebornCheckboxGroup v-model=\"form.topics\" :options=\"topicOptions\" />\n        </RebornFormItem>\n        <RebornFormItem prop=\"notifications\" label=\"报名通知\">\n          <div class=\"flex flex-wrap items-center gap-3\">\n            <RebornSwitch v-model=\"form.notifications\" aria-label=\"启用报名通知\" />\n            <span class=\"text-muted text-sm\">{{ form.notifications ? '已启用，通知邮箱为必填' : '关闭后禁用邮箱，并跳过邮箱校验' }}</span>\n          </div>\n        </RebornFormItem>\n        <RebornFormItem prop=\"email\" label=\"通知邮箱\" :required=\"form.notifications\">\n          <RebornInput v-model=\"form.email\" :disabled=\"!form.notifications\" placeholder=\"organizer@example.com\" />\n        </RebornFormItem>\n        <RebornFormItem prop=\"rating\" label=\"期待程度\" required>\n          <RebornRate v-model=\"form.rating\" clearable show-value @change=\"validateField('rating')\" />\n        </RebornFormItem>\n        <RebornFormItem prop=\"themeColor\" label=\"活动标识颜色\">\n          <div class=\"flex items-center gap-3\">\n            <RebornColorPicker v-model=\"form.themeColor\" />\n            <span class=\"text-muted font-mono text-sm\">{{ form.themeColor }}</span>\n          </div>\n        </RebornFormItem>\n        <RebornFormItem prop=\"description\" label=\"活动介绍\" required class=\"md:col-span-2\">\n          <RebornTextarea v-model=\"form.description\" :rows=\"3\" :maxlength=\"200\" :ui=\"{ root: 'bg-gray-1' }\" show-word-limit placeholder=\"介绍活动内容，至少 10 个字\" />\n        </RebornFormItem>\n        <RebornFormItem prop=\"collaborators\" label=\"邀请协作者（选填）\" class=\"md:col-span-2\">\n          <RebornMention v-model=\"form.collaborators\" :options=\"collaboratorOptions\" placeholder=\"输入 @ 选择协作者，再补充邀请说明\" />\n        </RebornFormItem>\n        <RebornFormItem prop=\"agreed\" label=\"信息确认\" required class=\"md:col-span-2\">\n          <RebornCheckbox v-model=\"form.agreed\" label=\"我已确认活动时间、人数与联系方式\" />\n        </RebornFormItem>\n      </div>\n\n      <div class=\"border-default flex flex-wrap items-center gap-3 border-t pt-4\">\n        <RebornButton @click=\"submit\">校验并提交</RebornButton>\n        <RebornButton variant=\"outlined\" color=\"neutral\" @click=\"reset\">重置联动表单</RebornButton>\n        <p role=\"status\" class=\"text-sm\" :class=\"result === 'error' ? 'text-error' : 'text-muted'\">\n          {{ result === 'success' ? '校验通过，已生成本地提交快照。' : result === 'error' ? `还有 ${errorCount} 个字段需要检查。` : '提交会校验当前生效的字段，重置会恢复初始数据。' }}\n        </p>\n      </div>\n    </RebornForm>\n\n    <div class=\"bg-elevated space-y-2 rounded-lg p-4\" :style=\"{ '--event-color': form.themeColor }\">\n      <div class=\"flex items-center gap-2\">\n        <span class=\"size-3 shrink-0 rounded-full bg-(--event-color)\" />\n        <span class=\"font-medium\">{{ form.title || '未命名活动' }}</span>\n      </div>\n      <p class=\"text-muted text-sm\">\n        {{ form.mode === 'online' ? '线上活动' : '线下活动' }} · {{ form.capacity }} 人 · {{ form.topics.length }} 个主题 · 期待 {{ form.rating }} / 5\n      </p>\n      <p v-if=\"form.collaborators\" class=\"text-muted break-words text-sm\">{{ form.collaborators }}</p>\n    </div>\n    <details class=\"border-default rounded-lg border p-4\">\n      <summary class=\"cursor-pointer text-sm\">查看{{ submitted ? '提交快照' : '实时表单数据' }}</summary>\n      <pre class=\"text-muted mt-3 max-h-80 overflow-auto text-xs\">{{ submitted || JSON.stringify(form, null, 2) }}</pre>\n    </details>\n  </div>\n</template>\n"
    },
    {
      "title": "UniApp 演示",
      "path": "packages/uniapp-project/src/pages/reborn-form/RebornFormDemo.vue",
      "source": "demo",
      "platform": "uniapp",
      "code": "<script setup lang=\"ts\">\nimport { computed, ref, shallowRef } from 'vue'\nimport * as z from 'zod'\nimport RebornButton from '@/components/reborn-button/RebornButton.vue'\nimport RebornCard from '@/components/reborn-card/RebornCard.vue'\n\nimport RebornCheckbox from '@/components/reborn-checkbox/RebornCheckbox.vue'\nimport RebornDatePicker from '@/components/reborn-date-picker/RebornDatePicker.vue'\nimport RebornForm from '@/components/reborn-form/RebornForm.vue'\nimport RebornFormItem from '@/components/reborn-form/RebornFormItem.vue'\nimport RebornInputNumber from '@/components/reborn-input-number/RebornInputNumber.vue'\nimport RebornInput from '@/components/reborn-input/RebornInput.vue'\nimport RebornPage from '@/components/reborn-page/RebornPage.vue'\nimport RebornSelect from '@/components/reborn-select/RebornSelect.vue'\nimport RebornSlider from '@/components/reborn-slider/RebornSlider.vue'\nimport RebornSwitch from '@/components/reborn-switch/RebornSwitch.vue'\nimport RebornText from '@/components/reborn-text/RebornText.vue'\nimport RebornTextarea from '@/components/reborn-textarea/RebornTextarea.vue'\n\ninterface FormData {\n  username: string\n  gender: 0 | 1 | 2 | undefined\n  password: string\n  newPassword: string\n  email: string\n  age: number | undefined\n  bio: string\n  interest: string[]\n  contacts: Contact[]\n  isAgree: boolean\n  height: number\n  weight: number\n  birthday: string\n  dateRange: string[]\n}\n\ninterface Contact {\n  id: number\n  name: string\n  phone: string\n  email: string\n  no: number\n}\n\nconst formRef = ref<InstanceType<typeof RebornForm> | null>(null)\nconst immediateValidate = shallowRef(true)\nconst formTrigger = computed<'none' | Array<'blur' | 'change'>>(() => immediateValidate.value ? ['change', 'blur'] : 'none')\n/** 关闭后表单项不再渲染错误文字，控件的错误描边仍在，用来对照 show-message 的效果 */\nconst showMessage = shallowRef(true)\n\nconst form = ref<FormData>({\n  username: '乐一番',\n  gender: 1,\n  password: 'aA123456789!',\n  newPassword: 'aA1234562789!',\n  email: '1114321@qq.com',\n  age: 18,\n  bio: '',\n  height: 180,\n  weight: 70,\n  birthday: '2000-01-01',\n  dateRange: [],\n  interest: [],\n  contacts: [],\n  isAgree: false,\n})\n\n// 性别选项\nconst genderOptions = [\n  {\n    label: '未知',\n    value: 0,\n  },\n  {\n    label: '男',\n    value: 1,\n  },\n  {\n    label: '女',\n    value: 2,\n  },\n]\n\nconst emailRule = z.string().email('邮箱格式不正确').refine(val => val.endsWith('@qq.com') || val.endsWith('@163.com'), '仅支持 QQ 或 163 邮箱')\nconst phoneSchema = z.string()\n  .min(11, { message: '手机号长度不足' })\n  .max(11, { message: '手机号长度超出' })\n  .regex(/^1[3-9]\\d{9}$/, { message: '手机号格式不正确' })\nconst passwordSchema = z.string().min(8, '密码至少8位').regex(/^(?=.*[a-z])(?=.*[A-Z])(?=.*\\W).+$/, '需包含大小写字母和特殊符号')\nconst rules = z.object({\n  username: z.string().min(3, '用户名至少3个字符'),\n  password: passwordSchema,\n  newPassword: passwordSchema.refine(val => val !== form.value.password, '新密码不能与旧密码相同'),\n  gender: z.preprocess(\n    (val) => (val === '' || val === null || val === undefined) ? undefined : Number(val),\n    z.number({ message: '请选择性别' })\n      .refine((n) => [0, 1, 2].includes(n), '请选择性别'),\n  ),\n  email: emailRule,\n  age: z.number()\n    .min(18, { message: '年龄最小不能小于 18 岁' })\n    .max(100, { message: '年龄最大不能超过 100 岁' }),\n  height: z.number()\n    .min(160, { message: '身高不能小于160cm' })\n    .max(190, { message: '身高不能大于190cm' }),\n  weight: z.number()\n    .min(50, { message: '体重不能小于50kg' })\n    .max(100, { message: '体重不能大于100kg' }),\n  birthday: z.string().min(1, '请选择出生年月'),\n  dateRange: z.array(z.string()).length(2, '请选择完整的时间范围'),\n  interest: z.array(z.string()).min(1, '请至少选择一项兴趣爱好'),\n  isAgree: z.literal(true, {\n    message: '请同意协议',\n  }),\n  bio: z.string().min(10, '简介至少10个字符').optional().or(z.literal('')),\n  contacts: z.array(z.object({\n    name: z.string().min(2, 'Name 最少两个字符'),\n    phone: phoneSchema,\n    email: emailRule,\n    no: z.coerce.number(),\n  }))\n    .min(3, '联系人至少需要3个')\n    .refine((items) => {\n      // 逻辑：校验 no 和 money 是否递增\n      for (let i = 1; i < items.length; i++) {\n        if (items[i].no <= items[i - 1].no) {\n          return false\n        }\n      }\n      return true\n    }, {\n      message: '排序必须是递增的',\n    }),\n})\n\nlet contactId = 0\nfunction addContact() {\n  form.value.contacts.push({\n    id: ++contactId,\n    phone: '',\n    email: '',\n    name: '',\n    no: 0,\n  })\n}\n\nasync function submit() {\n  if (!formRef.value) { return }\n\n  const valid = await formRef.value.validate((isValid: boolean) => {\n    if (!isValid) {\n      uni.showToast({\n        title: '请检查表单',\n        icon: 'none',\n      })\n    }\n  })\n\n  if (valid) {\n    uni.showToast({\n      title: '提交成功',\n      icon: 'success',\n    })\n  }\n}\n\nfunction reset() {\n  formRef.value?.resetFields()\n}\n\nfunction scrollToBio() {\n  formRef.value?.scrollToField('bio')\n}\n</script>\n\n<template>\n  <RebornPage title=\"Form 表单\" description=\"表单组件用于数据录入与校验，支持多种校验规则、错误提示、禁用状态等功能。\">\n    <RebornCard title=\"表单验证\">\n      <!-- 与下方「实时校验」同属开关区，分隔线由下方那一行的 border-b 统一给出 -->\n      <view class=\"mb-4 flex items-center justify-between\">\n        <text class=\"text-sm text-gray-6\">\n          显示错误信息（关闭后只保留控件的错误描边）\n        </text>\n        <RebornSwitch v-model=\"showMessage\" />\n      </view>\n      <view class=\"\n          mb-4 flex items-center justify-between border-b border-gray-100 pb-4\n          dark:border-gray-800\n        \">\n        <text class=\"\n            text-sm text-gray-6\n            dark:text-gray-4\n          \">\n          开启实时校验（输入内容时立即见效）\n        </text>\n        <RebornSwitch v-model=\"immediateValidate\" />\n      </view>\n\n      <RebornForm ref=\"formRef\" :model-value=\"form\" :rules=\"rules\" label-width=\"160rpx\" label-position=\"left\" size=\"sm\"\n        :trigger=\"formTrigger\" :show-message=\"showMessage\">\n        <RebornFormItem prop=\"username\" label=\"用户名\" required>\n          <RebornInput v-model=\"form.username\" placeholder=\"请输入用户名\" />\n        </RebornFormItem>\n\n        <RebornFormItem prop=\"interest\" label=\"兴趣爱好\" required>\n          <view class=\"flex flex-wrap gap-2\">\n            <RebornCheckbox v-model=\"form.interest\" value=\"a\" label=\"篮球\" />\n            <RebornCheckbox v-model=\"form.interest\" value=\"b\" label=\"足球\" />\n            <RebornCheckbox v-model=\"form.interest\" value=\"c\" label=\"乒乓球\" />\n            <RebornCheckbox v-model=\"form.interest\" value=\"d\" label=\"羽毛球\" />\n          </view>\n        </RebornFormItem>\n\n        <RebornFormItem prop=\"gender\" label=\"性别\" required>\n          <RebornSelect v-model=\"form.gender\" :options=\"genderOptions\" />\n        </RebornFormItem>\n\n        <RebornFormItem prop=\"birthday\" label=\"出生年月\" required>\n          <RebornDatePicker v-model=\"form.birthday\" type=\"date\" placeholder=\"请选择出生年月\" />\n        </RebornFormItem>\n\n        <RebornFormItem prop=\"dateRange\" label=\"入职时间\" required>\n          <RebornDatePicker v-model:values=\"form.dateRange\" type=\"date\" rangeable />\n        </RebornFormItem>\n\n        <RebornFormItem prop=\"isAgree\" label=\"是否同意\" required>\n          <RebornSwitch v-model=\"form.isAgree\" active-label=\"同意\" inactive-label=\"不同意\" />\n        </RebornFormItem>\n\n        <RebornFormItem prop=\"password\" label=\"密码\" required>\n          <RebornInput v-model=\"form.password\" placeholder=\"请输入密码\" password />\n        </RebornFormItem>\n\n        <RebornFormItem prop=\"newPassword\" label=\"新密码\" required>\n          <RebornInput v-model=\"form.newPassword\" placeholder=\"请输入新密码\" password />\n        </RebornFormItem>\n\n        <RebornFormItem prop=\"email\" label=\"邮箱\" required>\n          <RebornInput v-model=\"form.email\" placeholder=\"请输入邮箱\" />\n        </RebornFormItem>\n\n        <RebornFormItem prop=\"age\" label=\"年龄\" required>\n          <RebornInputNumber v-model=\"form.age\" placeholder=\"请输入年龄\" />\n        </RebornFormItem>\n\n        <RebornFormItem prop=\"height\" label=\"身高\" required>\n          <RebornSlider v-model=\"form.height\" :max=\"220\">\n            <template #value=\"{ value }\">\n              <RebornText :ui=\"{ base: 'w-[40px] text-xs' }\">\n                {{ value }}cm\n              </RebornText>\n            </template>\n          </RebornSlider>\n        </RebornFormItem>\n\n        <RebornFormItem prop=\"weight\" label=\"体重\" required>\n          <RebornSlider v-model=\"form.weight\" :max=\"150\">\n            <template #value=\"{ value }\">\n              <RebornText :ui=\"{ base: 'w-[40px] text-xs' }\">\n                {{ value }}kg\n              </RebornText>\n            </template>\n          </RebornSlider>\n        </RebornFormItem>\n\n        <!-- 演示自定义 UI 样式覆盖 -->\n        <RebornFormItem prop=\"bio\" label=\"个人简介\" :ui=\"{ label: 'text-blue-500', error: 'text-sm font-bold' }\">\n          <view>\n            <RebornTextarea v-model=\"form.bio\" placeholder=\"请输入简介 (选填)\" />\n          </view>\n        </RebornFormItem>\n\n        <RebornFormItem prop=\"contacts\" required label-position=\"top\">\n          <template #label>\n            <view class=\"flex w-full items-center justify-between gap-2\">\n              <view class=\"flex-1\">\n                联系人\n              </view>\n              <RebornButton @click=\"addContact\">\n                <template #leading>\n                  <view class=\"i-lucide-circle-plus size-4\" />\n                </template>\n                添加联系人\n              </RebornButton>\n            </view>\n          </template>\n          <view v-for=\"(contact, index) in form.contacts\" :key=\"contact.id\"\n            class=\"mb-4 flex flex-col rounded-xl p-4 ring-1 ring-gray-200\">\n            <view class=\"\n                mb-4 flex items-center gap-1 border-b border-gray-200 pb-2\n                text-26 font-medium text-gray-8\n                dark:text-gray-1\n              \">\n              联系人 {{ index + 1 }}\n            </view>\n            <RebornFormItem :prop=\"`contacts-${index}-name`\" label=\"姓名\" required label-position=\"top\"\n              require-asterisk-position=\"left\">\n              <RebornInput v-model=\"contact.name\" placeholder=\"请输入姓名\" />\n            </RebornFormItem>\n            <RebornFormItem :prop=\"`contacts-${index}-phone`\" label=\"手机号\" required label-position=\"top\"\n              require-asterisk-position=\"left\">\n              <RebornInput v-model=\"contact.phone\" placeholder=\"请输入手机号\" />\n            </RebornFormItem>\n            <RebornFormItem :prop=\"`contacts-${index}-email`\" label=\"邮箱\" required label-position=\"top\"\n              require-asterisk-position=\"left\">\n              <RebornInput v-model=\"contact.email\" placeholder=\"请输入邮箱\" />\n            </RebornFormItem>\n            <RebornFormItem :prop=\"`contacts-${index}-no`\" label=\"序号\" required label-position=\"top\"\n              require-asterisk-position=\"left\">\n              <RebornInputNumber v-model=\"contact.no\" placeholder=\"请输入序号\" />\n            </RebornFormItem>\n          </view>\n        </RebornFormItem>\n      </RebornForm>\n\n      <view class=\"mt-8 flex flex-col gap-3\">\n        <RebornButton :ui=\"{ base: 'w-full' }\" @click=\"submit\">\n          提交\n        </RebornButton>\n        <RebornButton variant=\"outlined\" :ui=\"{ base: 'w-full' }\" @click=\"reset\">\n          重置\n        </RebornButton>\n        <RebornButton variant=\"subtle\" :ui=\"{ base: 'w-full' }\" @click=\"scrollToBio\">\n          滚动到简介\n        </RebornButton>\n      </view>\n    </RebornCard>\n    <RebornCard title=\"数据\">\n      <view class=\"\n          overflow-hidden rounded-lg bg-gray-50 p-4\n          dark:bg-gray-900\n        \">\n        <text class=\"\n            select-text whitespace-pre-wrap break-all font-mono text-xs\n            leading-5 text-gray-7\n            dark:text-gray-3\n          \">\n          {{ JSON.stringify(form, null, 4) }}\n        </text>\n      </view>\n    </RebornCard>\n  </RebornPage>\n</template>\n"
    }
  ],
  "related": [],
  "whenToUse": [
    "多字段数据录入并需要统一校验（rules 传入 z.ZodObject）。",
    "需要 validate/validateField/resetFields/clearValidate 等程序化表单控制。",
    "需要统一控制标签位置/宽度、必填星号、尺寸与禁用态的表单。",
    "校验失败需自动滚动到错误项（scrollToError 默认开启）的长表单。"
  ],
  "whenNotToUse": [
    "单个独立输入控件无需校验时，直接用 reborn-input、reborn-select 等控件即可。",
    "只读的键值信息展示，web 端改用 reborn-descriptions。"
  ],
  "pitfalls": [
    "web 与 uniapp 双端可用。",
    "校验规则基于 zod：rules 须传 z.ZodObject，而非 Element 风格的规则数组。",
    "表单项须使用配套的 RebornFormItem 且置于 RebornForm 内；使用 validate/resetFields 时表单项的 prop 字段必填。",
    "trigger 默认 'none' 不自动校验，需设为 'blur'/'change' 或手动调用暴露的 validate。",
    "labelWidth 默认值双端不同：web 端 '140px'，uniapp 端 '140rpx'。",
    "resetFields 恢复的是挂载时的初始值快照，异步回填数据后需调用 setInitialValues 更新快照。",
    "resetFields 直接改写 modelValue 的字段，model 必须是父组件持有的 reactive 对象；web 端快照为保留类型的深拷贝（Date 不会变字符串、初值为 undefined 的字段也能被重置）。"
  ],
  "dependencies": [
    "@weapp-tailwindcss/merge-v3",
    "@weapp-tailwindcss/variants-v3",
    "clsx",
    "tailwind-merge",
    "tailwind-variants",
    "zod"
  ],
  "install": {
    "cli": "npx reborn-ui@latest add reborn-form"
