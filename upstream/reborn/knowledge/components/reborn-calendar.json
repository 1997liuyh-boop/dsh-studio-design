    {
      "title": "Web 演示 · RebornCalendarEventsDemo",
      "path": "app/components/reborn/examples/reborn-calendar/RebornCalendarEventsDemo.vue",
      "source": "demo",
      "platform": "web",
      "code": "<script setup lang=\"ts\">\nimport type { CalendarEvent, CalendarMode } from \"~/components/reborn/ui/reborn-calendar\";\nimport type { RebornContextMenuItem } from \"~/components/reborn/ui/reborn-context-menu/RebornContextMenu.vue\";\nimport { computed, ref, shallowRef, useId } from \"vue\";\nimport RebornButton from \"~/components/reborn/ui/reborn-button/RebornButton.vue\";\nimport { formatDay } from \"~/components/reborn/ui/reborn-calendar/reborn-calendar.utils\";\nimport RebornCalendar from \"~/components/reborn/ui/reborn-calendar/RebornCalendar.vue\";\nimport RebornContextMenu from \"~/components/reborn/ui/reborn-context-menu/RebornContextMenu.vue\";\nimport RebornDialog from \"~/components/reborn/ui/reborn-dialog/RebornDialog.vue\";\nimport RebornInput from \"~/components/reborn/ui/reborn-input/RebornInput.vue\";\n\ninterface DemoEvent extends CalendarEvent {\n  /** 稳定标识用于删除单条事项，同名事项也能分别保留。 */\n  id: number;\n  date: string;\n}\n\n/** 事项由示例维护；日期使用字符串，避免序列化时因时区偏移一天。 */\nconst today = formatDay(new Date());\nconst selectedDay = shallowRef(today);\nconst mode = shallowRef<CalendarMode>(\"month\");\nconst events = ref<DemoEvent[]>([\n  { id: 1, date: today, title: \"团队例会\" },\n  { id: 2, date: today, title: \"整理本周计划\", color: \"success\" },\n]);\nlet nextId = 3;\nconst activeDay = shallowRef(today);\nconst action = shallowRef<\"add\" | \"delete\">(\"add\");\nconst dialogOpen = shallowRef(false);\nconst draft = shallowRef(\"\");\nconst lastAction = shallowRef(\"右键日期可添加或删除事项；切换到年视图可按月查看。\");\nconst inputId = useId();\nconst activeEvents = computed(() => events.value.filter((event) => event.date === activeDay.value));\nconst dateLabel = computed(() => {\n  const [year, month, day] = activeDay.value.split(\"-\");\n  return `${year}年${Number(month)}月${Number(day)}日`;\n});\nconst dialogTitle = computed(() => `${dateLabel.value}事项${action.value === \"add\" ? \"添加\" : \"删除\"}`);\n\n/** 右键操作只管理目标日期，不因补位格的选择行为切换月份。 */\nfunction openDialog(day: string, operation: \"add\" | \"delete\") {\n  activeDay.value = day;\n  action.value = operation;\n  draft.value = \"\";\n  dialogOpen.value = true;\n}\n\n/** 全日历共用一个菜单，只为右键命中的日期计算菜单项。 */\nconst menuDay = shallowRef(\"\");\nconst menuOpen = shallowRef(false);\nconst menuItems = computed(() =>\n  menuDay.value ? dateMenu(menuDay.value, events.value.filter((event) => event.date === menuDay.value).length) : [],\n);\n\n/** 捕获阶段先解析格子，落在工具栏或年视图时阻止菜单打开。 */\nfunction onCellContextMenu(event: MouseEvent) {\n  const target = event.target;\n  const cell = target instanceof Element ? target.closest<HTMLElement>(\"[data-event-day]\") : null;\n  menuDay.value = cell?.dataset.eventDay ?? \"\";\n  if (!menuDay.value) {\n    menuOpen.value = false;\n    event.stopPropagation();\n  }\n}\n\n/** 当天没有事项时，删除操作保持禁用。 */\nfunction dateMenu(day: string, count: number): RebornContextMenuItem[] {\n  return [\n    { label: \"添加事项\", icon: \"lucide:plus\", onSelect: () => openDialog(day, \"add\") },\n    {\n      label: \"删除事项\",\n      icon: \"lucide:trash-2\",\n      color: \"error\",\n      disabled: count === 0,\n      onSelect: () => openDialog(day, \"delete\"),\n    },\n  ];\n}\n\n/** 添加后保留弹窗并清空输入，便于为同一天连续添加多条。 */\nfunction addEvent() {\n  const title = draft.value.trim();\n  if (!title) return;\n  events.value.push({ id: nextId++, date: activeDay.value, title });\n  draft.value = \"\";\n  lastAction.value = `已为 ${activeDay.value} 添加：${title}`;\n}\n\n/** 输入法确认候选词时不提交，普通回车与添加按钮行为一致。 */\nfunction onInputKeydown(event: KeyboardEvent) {\n  if (event.key === \"Enter\" && !event.isComposing) {\n    event.preventDefault();\n    addEvent();\n  }\n}\n\n/** 按稳定标识删除单条，不影响当天或其他日期的其余事项。 */\nfunction deleteEvent(event: DemoEvent) {\n  events.value = events.value.filter((item) => item.id !== event.id);\n  lastAction.value = `已删除 ${event.date} 的事项：${event.title}`;\n}\n</script>\n\n<template>\n  <div class=\"flex w-full flex-col gap-4\">\n    <RebornContextMenu v-model:open=\"menuOpen\" :items=\"menuItems\" :ui=\"{ wrapper: 'w-full', trigger: 'w-full' }\">\n      <RebornCalendar\n        v-model=\"selectedDay\"\n        v-model:mode=\"mode\"\n        :events=\"events\"\n        value-format=\"YYYY-MM-DD\"\n        title-align=\"left\"\n        border\n        @contextmenu.capture=\"onCellContextMenu\"\n      >\n        <template #date-cell=\"{ data, events: dayEvents }\">\n          <div :data-event-day=\"data.day\" class=\"flex min-h-24 flex-col gap-1\">\n            <button\n              type=\"button\"\n              :aria-label=\"data.day\"\n              class=\"flex size-6 items-center justify-center rounded-full text-base tabular-nums\"\n              :class=\"\n                data.isSelected\n                  ? 'bg-primary text-gray-1'\n                  : data.type === 'current-month'\n                    ? 'text-gray-9'\n                    : 'text-gray-5'\n              \"\n            >\n              {{ data.date.getDate() }}\n            </button>\n            <ul class=\"flex h-16 flex-col overflow-y-auto overscroll-contain [scrollbar-width:thin]\">\n              <li\n                v-for=\"event in dayEvents\"\n                :key=\"event.id\"\n                :title=\"event.title\"\n                class=\"shrink-0 truncate text-base text-gray-8\"\n              >\n                {{ event.title }}\n              </li>\n            </ul>\n          </div>\n        </template>\n      </RebornCalendar>\n    </RebornContextMenu>\n    <p role=\"status\" class=\"text-sm text-gray-7\">{{ lastAction }}</p>\n\n    <RebornDialog\n      v-model=\"dialogOpen\"\n      :title=\"dialogTitle\"\n      :width=\"420\"\n      align-center\n      :confirm-btn=\"false\"\n      :cancel-btn=\"false\"\n      destroy-on-close\n    >\n      <div class=\"flex flex-col gap-4\">\n        <div v-if=\"action === 'add'\" class=\"flex flex-col gap-2 py-4\">\n          <label :for=\"inputId\" class=\"text-base text-gray-8\">事项内容</label>\n          <RebornInput :id=\"inputId\" v-model=\"draft\" placeholder=\"请输入事项内容\" autofocus @keydown=\"onInputKeydown\" />\n        </div>\n        <ul v-if=\"activeEvents.length\" class=\"flex max-h-64 flex-col gap-2 overflow-y-auto\">\n          <li v-for=\"event in activeEvents\" :key=\"event.id\" class=\"flex min-w-0 items-center gap-2\">\n            <span class=\"min-w-0 flex-1 break-words text-base text-gray-8\">{{ event.title }}</span>\n            <RebornButton\n              v-if=\"action === 'delete'\"\n              size=\"sm\"\n              color=\"error\"\n              variant=\"text\"\n              :aria-label=\"`删除${event.title}`\"\n              @click=\"deleteEvent(event)\"\n            >\n              删除\n            </RebornButton>\n          </li>\n        </ul>\n        <p v-else class=\"text-sm text-gray-6\">当天暂无事项</p>\n      </div>\n      <template #footer>\n        <RebornButton size=\"sm\" color=\"neutral\" variant=\"outlined\" @click=\"dialogOpen = false\">关闭</RebornButton>\n        <RebornButton\n          v-if=\"action === 'add'\"\n          size=\"sm\"\n          color=\"primary\"\n          variant=\"filled\"\n          :disabled=\"!draft.trim()\"\n          @click=\"addEvent\"\n        >\n          添加\n        </RebornButton>\n      </template>\n    </RebornDialog>\n  </div>\n</template>\n"
    }
  ],
  "related": [
    "reborn-button",
    "reborn-radio",
    "reborn-select"
  ],
  "whenToUse": [
    "排期、值班、会议这类按天归档的事项总览：传 events，有事项的日期自动高亮。",
    "需要在日历上新增、删除事项：在 date-cell 插槽里组合 reborn-context-menu 与 reborn-dialog，自己维护 events。",
    "事项量大、要按可见月份分批拉取：监听 panel-change，按回传的日期与模式请求数据。",
    "只关心某两三周（如一个迭代周期）：传 range，日历只显示这段日期。",
    "年度规划的月份概览：v-model:mode=\"year\"，12 个月各自汇总当月事项，每条显示 YYYY-MM-DD：事项内容。",
    "面向国内用户、需要看节日节气的排期：开 lunar，公历日期在上，较小的农历、节日或节气在下。",
    "选中日期要提交给接口，或用户与服务端不在同一时区：value-format=\"YYYY-MM-DD\" 收发字符串，必要时加 timezone。"
  ],
  "whenNotToUse": [
    "只是在表单里选一个日期或区间，改用 reborn-date-picker。",
    "按时间先后展示一串事件、日期本身不重要，改用 reborn-timeline。",
    "需要按小时排程、拖拽调整时长的周视图 / 日视图，本库暂无替代，需接入专门的排程库。"
  ],
  "pitfalls": [
    "仅 web 端可用；UniApp 端只选日期时用 reborn-date-picker。",
    "视图跟着 v-model 走：翻页、改年月下拉、点「今天」都会改写选中日期，没有独立的显示月份。",
    "controller-type 默认是 select（年月下拉），与 el-calendar 的默认 button 不同。",
    "一周固定从周日开始，没有 first-day-of-week 配置。",
    "range 会自动补齐整周，但原始区间必须同月或相邻月，否则控制台警告并退回普通月视图。",
    "事项按天归档，不支持跨天事项；跨天的需要按天拆成多条。",
    "用了 date-cell 插槽后默认的日期标题、农历文字与事项列表一起被替换，相关 ui 键失效；date-cell 只作用于月视图。",
    "默认 v-model 是 Date：东八区 10 月 20 日零点序列化后是 2026-10-19T16:00:00.000Z，提交接口会差一天；用 value-format 让 v-model 收发字符串。",
    "timezone 传 IANA 名称，决定「今天」、带 Z / 偏移的时刻落在哪天、向外派发的 Date 取哪个时区零点；不带时区的字符串（如 2026-10-20）始终按日期落格。new Date('2026-10-20') 按 UTC 解析，西半球会变前一天，事项日期应传字符串。",
    "未传 timezone 时通过 useId 或外部 id 对应的 SSR 根节点携带服务器时区与当天日期到客户端：水合前两端按服务器时区算「今天」与月份，挂载后切回用户本地时区并修正类名；两者不同时首屏可能与挂载后差一天，月份变化会派发一次 panel-change，需要首屏即最终结果就传 timezone。",
    "lunar 依赖运行环境的 Intl 中国历法（zh-CN-u-ca-chinese），不支持时静默不显示；节气只覆盖 2000–2099 年。date-cell 插槽的 data.lunar 与导出的 getLunar 提供完整农历信息。",
    "日历不内置编辑入口和新增、编辑事件；用 date-cell 自定义菜单与弹窗，并更新 events。演示的添加支持同日多条，删除按当天事项逐项处理；需要持久化时由业务自行保存。",
    "color 同时作用于工具栏的年月下拉与月 / 年切换；「今天」与翻页按钮按设计固定为 neutral 描边，不跟随 color。",
