{
  "$schema": "../schema/component.schema.json",
  "id": "reborn-guide",
  "title": "引导 Guide",
  "description": "Web 分步引导：自动居中并锁定目标，支持父子步骤、数字或点状进度、封面与整步组件替换。",
  "category": "basic",
  "tags": [
    "css",
    "tailwind",
    "guide",
    "tour"
  ],
  "aliases": [
    "guide",
    "引导",
    "新手引导",
    "tour",
    "分步引导"
  ],
  "platforms": [
    "web"
  ],
  "props": [
    {
      "name": "color",
      "type": "'primary' | 'secondary' | 'success' | 'info' | 'warning' | 'error' | 'neutral'",
      "required": false,
      "description": "可选语义色；省略时保留默认浅色面板。",
      "options": [
        "primary",
        "secondary",
        "success",
        "info",
        "warning",
        "error",
        "neutral"
      ]
    },
    {
      "name": "defaultCurrent",
      "type": "number",
      "required": false,
      "description": "未传入受控 `current` 时的初始步骤。",
      "default": "-1"
    },
    {
      "name": "steps",
      "type": "GuideStep[]",
      "required": true,
      "description": "必填的步骤树，按深度优先顺序展开。"
    },
    {
      "name": "mode",
      "type": "\"popup\" | \"dialog\"",
      "required": false,
      "description": "面板定位方式，可被步骤级 `mode` 覆盖。",
      "default": "\"popup\""
    },
    {
      "name": "indicator",
      "type": "\"counter\" | \"dots\"",
      "required": false,
      "description": "数字或点状步骤指示。",
      "default": "\"counter\""
    },
    {
      "name": "hideCounter",
      "type": "boolean",
      "required": false,
      "description": "隐藏默认步骤指示区域。",
      "default": "false"
    },
    {
      "name": "hidePrev",
      "type": "boolean",
      "required": false,
      "description": "隐藏上一步按钮；第一步始终不显示。",
      "default": "false"
    },
    {
      "name": "hideSkip",
      "type": "boolean",
      "required": false,
      "description": "隐藏跳过按钮；最后一步始终不显示。",
      "default": "true"
    },
    {
      "name": "finishButtonProps",
      "type": "ButtonProps",
      "required": false,
      "description": "完成按钮配置，默认 `primary`、`filled`、`sm`。"
    },
    {
      "name": "nextButtonProps",
      "type": "ButtonProps",
      "required": false,
      "description": "下一步按钮配置，默认 `primary`、`filled`、`sm`。"
    },
    {
      "name": "prevButtonProps",
      "type": "ButtonProps",
      "required": false,
      "description": "上一步按钮配置，默认 `neutral`、`outlined`、`sm`。"
    },
    {
      "name": "skipButtonProps",
      "type": "ButtonProps",
      "required": false,
      "description": "跳过按钮配置，受 `hideSkip` 控制。"
    },
    {
      "name": "showOverlay",
      "type": "boolean",
      "required": false,
      "description": "显示可见遮罩；关闭后仍拦截背景交互并锁定滚动。",
      "default": "true"
    },
    {
      "name": "highlightPadding",
      "type": "number",
      "required": false,
      "description": "高亮区域向目标边框外扩的距离，单位 px；默认等同 `p-1` 的 4px 间距，不改变面板相对目标边框的定位。",
      "default": "4"
    },
    {
      "name": "zIndex",
      "type": "number",
      "required": false,
      "description": "引导层级基值，面板位于遮罩上方。",
      "default": "999999"
    },
    {
      "name": "class",
      "type": "ClassValue",
      "required": false,
      "description": "追加面板类名。"
    },
    {
      "name": "ui",
      "type": "Partial<Record<\n    | \"overlay\" | \"highlightMask\" | \"guideBox\" | \"guideArrow\"\n    | \"guideHeader\" | \"guideTitle\" | \"guideBody\" | \"guideFooter\"\n    | \"counter\" | \"buttonGroup\" | \"dialogOverlay\" | \"dialogBox\"\n    | \"closeRow\" | \"closeButton\" | \"cover\" | \"indicators\" | \"indicatorDot\",\n    ClassValue\n  >>",
      "required": false,
      "description": "覆盖下表列出的内部节点类名。"
    },
    {
      "name": "current",
      "type": "number",
      "required": false,
      "description": "双向绑定值",
      "vModel": true,
      "default": "-1"
    }
  ],
  "events": [
    {
      "name": "change",
      "payload": "(e: \"change\", current: number, context?: { e: MouseEvent; total: number }): void;",
      "description": "已启动的引导切换到另一有效步骤时触发。"
    },
    {
      "name": "finish",
      "payload": "(e: \"finish\", context: GuideEventContext): void;",
      "description": "完成引导。"
    },
    {
      "name": "nextStepClick",
      "payload": "(e: \"nextStepClick\", context: GuideEventContext & { next: number }): void;",
      "description": "进入下一步；模板中写作 @next-step-click"
    },
    {
      "name": "prevStepClick",
      "payload": "(e: \"prevStepClick\", context: GuideEventContext & { prev: number }): void;",
      "description": "返回上一步；模板中写作 @prev-step-click"
    },
    {
      "name": "skip",
      "payload": "(e: \"skip\", context: GuideEventContext): void;",
      "description": "跳过剩余步骤。"
    },
    {
      "name": "close",
      "payload": "(e: \"close\", context: GuideEventContext): void;",
      "description": "关闭当前引导，与完成和跳过区分。"
    },
    {
      "name": "update:current",
      "description": "current 变化时触发（v-model 同步）",
      "payload": "current: number"
    }
  ],
  "slots": [
    {
      "name": "counter",
      "props": "(props: GuideStepContext) => any",
      "description": "替换默认步骤指示"
    }
  ],
  "exposes": [
    {
      "name": "next",
      "description": ""
    },
    {
      "name": "prev",
      "description": ""
    },
    {
      "name": "finish",
      "description": ""
    },
    {
      "name": "skip",
      "description": ""
    },
    {
      "name": "close",
      "description": ""
    }
  ],
  "examples": [
    {
      "title": "Web 演示",
      "path": "app/components/reborn/examples/reborn-guide/RebornGuideDemo.vue",
      "source": "demo",
      "platform": "web",
      "code": "<script setup lang=\"ts\">\nimport type { GuideStep } from \"~/components/reborn/ui/reborn-guide/RebornGuide.vue\";\nimport type { Placement } from \"~/lib/placement\";\nimport { DemoBlock, DemoNote, DemoSection, Playground } from \"#components\";\nimport { computed, markRaw, shallowRef, useTemplateRef } from 'vue';\nimport RebornButton from \"~/components/reborn/ui/reborn-button/RebornButton.vue\";\nimport { guideColors, guideModes, guidePlacements } from \"~/components/reborn/ui/reborn-guide/reborn-guide.config\";\nimport RebornGuide from \"~/components/reborn/ui/reborn-guide/RebornGuide.vue\";\nimport RebornGuideCustomStep from \"./RebornGuideCustomStep.vue\";\n\ntype Scenario = \"playground\" | \"basic\" | \"indicator\" | \"cover\" | \"children\" | \"component\";\n\n// ─── 交互演练场 ─────────────────────────────────────────────────\n\n/** 演练场全部可调参数。 */\nconst defaultState = {\n  color: \"\" as \"\" | (typeof guideColors)[number],\n  mode: \"popup\" as \"popup\" | \"dialog\",\n  placement: \"bottom\" as Placement,\n  indicator: \"counter\" as \"counter\" | \"dots\",\n  showOverlay: true,\n  hideCounter: false,\n  hidePrev: false,\n  hideSkip: true,\n};\nconst state = shallowRef({ ...defaultState });\nconst current = shallowRef(-1);\nconst scenario = shallowRef<Scenario>(\"playground\");\nconst scenarioIndicator = shallowRef<\"counter\" | \"dots\">(\"counter\");\nconst lastEvent = shallowRef(\"尚未开始\");\nconst targetClicks = shallowRef(0);\nconst playgroundTarget = useTemplateRef<HTMLElement>(\"playgroundTarget\");\nconst basicTarget = useTemplateRef<HTMLElement>(\"basicTarget\");\nconst actionTarget = useTemplateRef<HTMLElement>(\"actionTarget\");\nconst indicatorTarget = useTemplateRef<HTMLElement>(\"indicatorTarget\");\nconst coverTarget = useTemplateRef<HTMLElement>(\"coverTarget\");\nconst parentTarget = useTemplateRef<HTMLElement>(\"parentTarget\");\nconst nestedTarget = useTemplateRef<HTMLElement>(\"nestedTarget\");\nconst componentTarget = useTemplateRef<HTMLElement>(\"componentTarget\");\n\n/** 控件直接绑定引导实例，不另外覆盖演练场的步骤定位。 */\nconst controls = [\n  {\n    title: \"基础属性\",\n    children: [\n      { label: \"面板颜色\", key: \"color\", component: \"select\" as const, defaultValue: \"\", props: { options: [{ label: \"默认（不传）\", value: \"\" }, ...guideColors.map(value => ({ label: value, value }))] } },\n      { label: \"展示模式\", key: \"mode\", component: \"select\" as const, defaultValue: \"popup\", props: { options: guideModes.map(value => ({ label: value === \"popup\" ? \"浮层\" : \"对话框\", value })) } },\n      { label: \"浮层方向\", key: \"placement\", component: \"select\" as const, defaultValue: \"bottom\", props: { options: guidePlacements.map(value => ({ label: value, value })) } },\n      { label: \"步骤指示\", key: \"indicator\", component: \"select\" as const, defaultValue: \"counter\", props: { options: [{ label: \"数字\", value: \"counter\" }, { label: \"点状\", value: \"dots\" }] } },\n    ],\n  },\n  {\n    title: \"行为\",\n    children: [\n      { label: \"显示遮罩\", key: \"showOverlay\", component: \"checkbox\" as const, defaultValue: true },\n      { label: \"隐藏步骤指示\", key: \"hideCounter\", component: \"checkbox\" as const, defaultValue: false },\n      { label: \"隐藏上一步\", key: \"hidePrev\", component: \"checkbox\" as const, defaultValue: false },\n      { label: \"隐藏跳过\", key: \"hideSkip\", component: \"checkbox\" as const, defaultValue: true },\n    ],\n  },\n];\n\n/** 可复制代码同时展示步骤级定位与组件级配置。 */\nconst guideCode = computed(() => `<RebornGuide\n  v-model:current=\"current\"${state.value.color ? `\\n  color=\"${state.value.color}\"` : \"\"}\n  :steps=\"[{ element: '#target', title: '功能介绍', body: '阅读后继续。', placement: '${state.value.placement}' }]\"\n  mode=\"${state.value.mode}\"\n  indicator=\"${state.value.indicator}\"\n  :show-overlay=\"${state.value.showOverlay}\"\n  :hide-counter=\"${state.value.hideCounter}\"\n  :hide-prev=\"${state.value.hidePrev}\"\n  :hide-skip=\"${state.value.hideSkip}\"\n/>`);\n\n/** 关闭引导并重置所有演练参数及交互回显。 */\nfunction resetState() {\n  current.value = -1;\n  state.value = { ...defaultState };\n  lastEvent.value = \"尚未开始\";\n  targetClicks.value = 0;\n}\n\n// ─── 场景演示状态 ───────────────────────────────────────────────\n\n/** 使用内嵌插图，避免封面依赖外部图片服务。 */\nconst cover = `data:image/svg+xml,${encodeURIComponent('<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 480 240\"><rect width=\"480\" height=\"240\" fill=\"#eaf2ff\"/><rect x=\"90\" y=\"42\" width=\"300\" height=\"156\" rx=\"16\" fill=\"white\"/><rect x=\"114\" y=\"66\" width=\"140\" height=\"12\" rx=\"6\" fill=\"#3b82f6\"/><rect x=\"114\" y=\"98\" width=\"252\" height=\"10\" rx=\"5\" fill=\"#dbeafe\"/><rect x=\"114\" y=\"122\" width=\"204\" height=\"10\" rx=\"5\" fill=\"#dbeafe\"/><rect x=\"290\" y=\"150\" width=\"76\" height=\"24\" rx=\"6\" fill=\"#3b82f6\"/></svg>')}`;\n/** 组件对象保持原始引用，避免被步骤数组转换为响应式代理。 */\nconst customStep = markRaw(RebornGuideCustomStep);\n/** 统一维护引导实例，切换场景时只替换步骤数据。 */\nconst steps = computed<GuideStep[]>(() => {\n  switch (scenario.value) {\n    case \"playground\":\n      return [\n        { element: () => playgroundTarget.value, title: \"查看面板布局\", body: \"关闭按钮独占一行，标题、描述和操作区依次排列。\", placement: state.value.placement },\n        { element: () => playgroundTarget.value, title: \"结束本次引导\", body: \"引导期间页面保持静止；关闭后恢复滚动与目标交互。\", placement: state.value.placement },\n      ];\n    case \"basic\":\n      return [\n        { element: () => basicTarget.value, title: \"先了解工作区\", body: \"当前目标会自动滚动到视口中央，说明面板沿目标边缘定位。\", placement: \"bottom\" },\n        { element: () => actionTarget.value, title: \"查看操作入口\", body: \"引导期间点击此处不会触发目标按钮，完成后可再次点击验证。\", placement: \"top\", finishButtonProps: { label: \"开始使用\" } },\n      ];\n    case \"indicator\":\n      return [\n        { element: () => indicatorTarget.value, title: \"选择步骤指示\", body: \"数字显示当前步骤与总数；点状显示当前进度。\", nextButtonProps: { label: \"查看设置\" } },\n        { element: () => indicatorTarget.value, title: \"逐步定义按钮\", body: \"当前步骤可单独指定上一步和下一步的按钮文案。\", prevButtonProps: { label: \"返回介绍\" }, nextButtonProps: { label: \"确认设置\" } },\n        { element: () => indicatorTarget.value, title: \"准备就绪\", body: \"最后一步使用完成按钮，也能按步骤自定义文案。\", prevButtonProps: { label: \"修改设置\" }, finishButtonProps: { label: \"我知道了\" } },\n      ];\n    case \"cover\":\n      return [\n        { element: () => coverTarget.value, title: \"快速认识工作区\", body: \"可选封面使用 8px 圆角，与标题保留 16px 间距。\", cover, coverAlt: \"工作区示意图\", nextButtonProps: { label: \"阅读使用提示\" } },\n        { element: () => coverTarget.value, title: \"保留默认操作区\", content: \"featureBody\", finishButtonProps: { label: \"阅读完成\" } },\n      ];\n    case \"children\":\n      return [{\n        element: () => parentTarget.value,\n        title: \"父步骤：了解设置\",\n        body: \"父步骤先显示，随后按深度优先顺序进入子步骤。\",\n        nextButtonProps: { label: \"查看子步骤\" },\n        children: [\n          { title: \"子步骤：沿用目标\", body: \"未填写 element 时，子步骤继续使用父步骤的目标。\" },\n          {\n            element: () => nestedTarget.value,\n            title: \"子步骤：滚动容器\",\n            body: \"这个目标原本在滚动容器下方，进入步骤后会自动滚动到可见位置。\",\n            chidren: [{ title: \"兼容 chidren 写法\", body: \"chidren 是 children 的兼容别名；当前例子共计 4 步。\", finishButtonProps: { label: \"结束子步骤\" } }],\n          },\n        ],\n      }];\n    case \"component\":\n      return [\n        { element: () => componentTarget.value, component: customStep, componentProps: { heading: \"选择你的工作方式\", description: \"这一整块面板由独立 Vue 组件渲染，内部可以维护自己的交互状态。\" } },\n        { element: () => componentTarget.value, component: customStep, componentProps: { heading: \"自定义流程已就绪\", description: \"组件通过传入的 prev、finish、close 方法控制引导，无需访问外部实例。\" } },\n      ];\n  }\n  return [];\n});\n\n/** 场景示例固定基础行为，演练场参数只影响演练场。 */\nconst guideOptions = computed(() => scenario.value === \"playground\"\n  ? { ...state.value, color: state.value.color || undefined }\n  : { color: undefined, mode: \"popup\" as const, indicator: scenarioIndicator.value, showOverlay: true, hideCounter: false, hidePrev: false, hideSkip: true });\n\n/** 选定场景后从第一步开始。 */\nfunction startGuide(nextScenario: Scenario, indicator: \"counter\" | \"dots\" = \"counter\") {\n  scenario.value = nextScenario;\n  scenarioIndicator.value = indicator;\n  lastEvent.value = \"已开始：第 1 步\";\n  current.value = 0;\n}\n\n/** 回显实际切换到的扁平步骤索引。 */\nfunction onChange(index: number) {\n  if (index >= 0) lastEvent.value = `已切换：第 ${index + 1} 步`;\n}\n</script>\n\n<template>\n  <div class=\"flex w-full min-w-0 flex-col\" data-guide-demo>\n    <Playground v-model=\"state\" :controls=\"controls\" :code=\"guideCode\" component-name=\"RebornGuide\" title=\"交互演练场\" description=\"调节面板颜色、方向、步骤指示与操作按钮，再开始引导查看效果。\">\n      <template #tag>\n        <RebornButton size=\"sm\" color=\"neutral\" variant=\"soft\" @click=\"resetState\">重置配置</RebornButton>\n      </template>\n      <div class=\"flex w-full flex-col items-center gap-4\">\n        <div ref=\"playgroundTarget\" class=\"w-full max-w-sm rounded-lg border border-gray-4 bg-gray-1 p-4\" data-guide-target=\"playground\">\n          <p class=\"text-base font-medium text-gray-10\">演练场目标</p>\n          <p class=\"mt-2 text-base text-gray-8\">引导激活后，目标保持可见，页面与目标交互会被锁定。</p>\n        </div>\n        <RebornButton @click=\"startGuide('playground')\">开始演练引导</RebornButton>\n        <DemoNote tone=\"dimmed\" data-guide-event>{{ lastEvent }}</DemoNote>\n      </div>\n    </Playground>\n\n    <DemoSection title=\"基础引导\" class=\"relative z-50\">\n      <template #description>通过 <code>steps</code> 与 <code>v-model:current</code> 启动流程，切换时自动居中目标并锁定页面交互。</template>\n      <DemoBlock layout=\"stack\" class=\"gap-4\">\n        <RebornButton class=\"self-start\" @click=\"startGuide('basic')\">体验基础引导</RebornButton>\n        <div ref=\"basicTarget\" class=\"rounded-lg border border-gray-4 p-4\" data-guide-target=\"basic\">\n          <p class=\"text-base font-medium text-gray-10\">项目工作区</p>\n          <p class=\"mt-2 text-base text-gray-8\">在这里查看项目概况，再了解具体操作入口。</p>\n        </div>\n        <div ref=\"actionTarget\" class=\"self-start rounded-lg border border-gray-4 p-4\" data-guide-target=\"action\">\n          <RebornButton color=\"neutral\" variant=\"outlined\" @click=\"targetClicks++\">目标操作按钮</RebornButton>\n        </div>\n        <DemoNote tone=\"dimmed\" data-guide-clicks>目标已点击 {{ targetClicks }} 次；引导中的点击不会增加计数。</DemoNote>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection title=\"步骤指示与按钮\" class=\"relative z-40\">\n      <template #description><code>indicator</code> 切换数字或点状进度，每一步的按钮配置可覆盖默认文案。</template>\n      <DemoBlock layout=\"stack\" class=\"gap-4\">\n        <div class=\"flex flex-wrap gap-2\">\n          <RebornButton @click=\"startGuide('indicator', 'counter')\">数字步骤</RebornButton>\n          <RebornButton variant=\"outlined\" @click=\"startGuide('indicator', 'dots')\">点状步骤</RebornButton>\n        </div>\n        <div ref=\"indicatorTarget\" class=\"rounded-lg border border-gray-4 p-4 text-base text-gray-8\" data-guide-target=\"indicator\">三步流程：介绍 → 设置 → 完成。上一步、下一步与完成文案分别随步骤变化。</div>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection title=\"封面与内容插槽\" class=\"relative z-30\">\n      <template #description><code>cover</code> 添加封面，<code>content</code> 指定正文插槽并保留默认标题、步骤指示与按钮。</template>\n      <DemoBlock layout=\"stack\" class=\"gap-4\">\n        <RebornButton class=\"self-start\" @click=\"startGuide('cover')\">查看封面与插槽</RebornButton>\n        <div ref=\"coverTarget\" class=\"rounded-lg border border-gray-4 p-4 text-base text-gray-8\" data-guide-target=\"cover\">第一步展示封面与文字，第二步展示带清单的自定义正文。</div>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection title=\"子步骤与自动居中\" class=\"relative z-20\">\n      <template #description><code>children</code> 或兼容写法 <code>chidren</code> 定义子步骤，计数包含所有层级，未指定目标时继承父目标。</template>\n      <DemoBlock layout=\"stack\" class=\"gap-4\">\n        <RebornButton class=\"self-start\" @click=\"startGuide('children')\">开始父子步骤</RebornButton>\n        <div ref=\"parentTarget\" class=\"rounded-lg border border-gray-4 p-4 text-base text-gray-8\" data-guide-target=\"parent\">父步骤和第一个子步骤共用此目标。</div>\n        <div class=\"h-56 overflow-y-auto rounded-lg border border-gray-4 p-4\" data-guide-scroll-container>\n          <div class=\"flex h-64 items-start text-base text-gray-8\">下方还有一个子步骤目标，开始引导后会自动滚动至该处。</div>\n          <div ref=\"nestedTarget\" class=\"rounded-lg border border-dashed border-primary bg-primary/5 p-4 text-base text-gray-10\" data-guide-target=\"nested\">滚动容器中的子步骤目标</div>\n          <div class=\"h-64\" aria-hidden=\"true\" />\n        </div>\n        <DemoNote tone=\"dimmed\">顺序为父步骤 → 继承目标的子步骤 → 容器内子步骤 → 兼容写法的孙步骤，共 4 步。</DemoNote>\n      </DemoBlock>\n    </DemoSection>\n\n    <DemoSection title=\"整步自定义组件\" class=\"relative z-10\">\n      <template #description><code>component</code> 替换当前面板的全部内容，<code>componentProps</code> 传入业务数据，导航方法由引导注入。</template>\n      <DemoBlock layout=\"stack\" class=\"gap-4\">\n        <RebornButton class=\"self-start\" @click=\"startGuide('component')\">体验自定义面板</RebornButton>\n        <div ref=\"componentTarget\" class=\"rounded-lg border border-gray-4 p-4 text-base text-gray-8\" data-guide-target=\"component\">自定义组件拥有自己的布局和交互，外层仍负责定位、遮罩和滚动锁定。</div>\n      </DemoBlock>\n    </DemoSection>\n\n    <RebornGuide v-model:current=\"current\" :steps=\"steps\" :color=\"guideOptions.color\" :mode=\"guideOptions.mode\" :indicator=\"guideOptions.indicator\" :show-overlay=\"guideOptions.showOverlay\" :hide-counter=\"guideOptions.hideCounter\" :hide-prev=\"guideOptions.hidePrev\" :hide-skip=\"guideOptions.hideSkip\" @change=\"onChange\" @finish=\"lastEvent = '已完成引导'\" @skip=\"lastEvent = '已跳过引导'\" @close=\"lastEvent = '已关闭引导'\">\n      <template #featureBody=\"{ current: stepNumber, total }\">\n        <div class=\"flex flex-col gap-2\">\n          <p>当前为第 {{ stepNumber }} / {{ total }} 步，只替换正文区域。</p>\n          <ul class=\"list-inside list-disc space-y-2\">\n            <li>标题和关闭按钮继续使用默认布局。</li>\n            <li>步骤指示与操作按钮保持可用。</li>\n          </ul>\n        </div>\n      </template>\n    </RebornGuide>\n  </div>\n</template>\n"
    }
  ],
  "related": [
    "reborn-button"
  ],
  "whenToUse": [
    "首次进入页面介绍操作入口：用 steps 指定目标，把 current 从 -1 设为 0 启动。",
    "同一功能需要分层说明：用 children 定义子步骤，省略 element 时继承父目标。",
    "简短流程需要紧凑的步骤进度：用 indicator='dots'；精确进度使用默认 counter。",
    "需要图文说明或独立步骤交互：用 cover 添加封面，或用 component 替换整个面板内容。"
  ],
  "whenNotToUse": [
    "单个元素的悬浮提示，改用 reborn-tooltip；点击展开说明，改用 reborn-popover。",
    "需要用户实际点击高亮目标才能继续，改用 reborn-popover 配合业务状态。",
    "UniApp 页面不可使用，需自行结合页面状态与平台滚动 API 实现。"
  ],
  "pitfalls": [
    "仅 Web 端可用；启动引导时目标应已挂载，未找到目标则回退到屏幕中央并隐藏箭头。",
    "引导期间锁定页面与滚动容器的滚动并拦截目标交互；showOverlay=false 只隐藏可见遮罩。",
    "每一步自动将目标尽量居中，页面边界和固定定位可能限制实际居中位置。",
    "children 与 chidren 都支持子步骤，children 优先；按父后子的深度优先顺序展开，子步骤只继承 element。",
    "current 与事件步骤索引从 0 开始；插槽和自定义组件的 current 从 1 开始，总数包含所有父子步骤。",
    "content 是正文插槽名称；component 替换整个面板内容，需要自定义组件通过注入的导航方法提供关闭或完成操作。",
    "Vue 组件对象进入响应式步骤数据前建议使用 markRaw；componentProps 用于业务数据，步骤信息与导航方法由引导注入。",
    "highlightPadding 默认 4px；hideSkip 默认 true；按钮默认 sm，步骤级配置覆盖组件级配置。",
    "popupProps 是尚未接线的兼容保留字段，调整浮层请使用 placement、offset 与 ui。"
  ],
  "dependencies": [
    "clsx",
    "motion-v",
    "tailwind-merge",
    "tailwind-variants"
  ],
